@@ -22,23 +22,32 @@
 #include <stdio.h>
 #include <stdbool.h>
 #include <time.h>
+#include <stdlib.h>
 #include <string.h>
+#include <strings.h>
 
-// One DNS query with resolver state of its own. res_query keeps a single state for the whole process, so
-// lookups running at the same time on different threads (libcurl's threaded resolver starts several)
-// overwrote each other's and nearly all of them failed.
+/* res_query shares the global resolver's sockets. Concurrent lookups must
+ * own their resolver state so they cannot consume each other's replies. */
 static int
-dr_query(const char *name, int class, int type, u_char *answer, int anslen)
+dr_query(const char *name, int dns_class, int type, unsigned char *answer, int length)
 {
-	struct __res_state state;
-	int l;
+	struct __res_state state = {0};
+	int result;
+	/* Riot's bundled downloader cannot use IPv6 CONNECT_TO addresses.
+	 * Restrict this opt-in workaround to its CDN; keep other DNS unchanged. */
+	const char *ipv4_only = getenv("RCLOL_CDN_IPV4_ONLY");
+	size_t name_len = strlen(name);
+	const char suffix[] = ".riotcdn.net";
+	if (type == ns_t_aaaa && ipv4_only && strcmp(ipv4_only, "1") == 0 &&
+	    name_len >= sizeof(suffix) - 1 &&
+	    strcasecmp(name + name_len - (sizeof(suffix) - 1), suffix) == 0)
+		return -1;
 
-	memset(&state, 0, sizeof(state));
-	if (res_ninit(&state) != 0)
+	if (res_ninit(&state) < 0)
 		return -1;
-	l = res_nquery(&state, name, class, type, answer, anslen);
+	result = res_nquery(&state, name, dns_class, type, answer, length);
 	res_ndestroy(&state);
-	return l;
+	return result;
 }
 
 static int
@@ -393,4 +402,3 @@ si_mod_t *si_module_static_darling(void)
 	return (si_mod_t*)&si;
 
