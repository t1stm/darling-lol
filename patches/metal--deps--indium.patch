index 0000000..696b800
--- /dev/null
+++ b/private-include/indium/deferred-render-encoder.private.hpp
@@ -0,0 +1,372 @@
+#pragma once
+
+// Deferred render-command encoding.
+//
+// League's main thread spends 2-4.5 ms of every frame inside the Metal-to-Vulkan translation (PrivateRenderCommandEncoder:
+// binding bookkeeping, descriptor sets, vkCmd* calls). Nothing about that work has to happen on the game's thread: Metal
+// semantics only require that the encoder calls are applied in order before the command buffer is committed.
+//
+// This facade implements the public RenderCommandEncoder interface by recording every call into a compact op list
+// (copying anything the caller may reuse: setBytes data, viewport/scissor arrays) and, at endEncoding(), hands the list to
+// the ordered worker of submit-thread.private.hpp, which creates the real PrivateRenderCommandEncoder, replays the ops into
+// it and ends it. The same worker later runs the command buffer's commit(), so encoders are always fully replayed before
+// the commit looks at them. Everything that touches the same Vulkan command buffer from another thread (blit/compute
+// encoders, a direct render encoder) first waits for the command buffer's pending replays (waitDeferred()).
+//
+// Live switch (guest file, re-read every 256 encoders): /tmp/metal-async-encode present = on. Off by default while it is
+// validated. Header-only: the build script compiles only the .cpp files of the CMake target.
+
+#include <indium/render-command-encoder.hpp>
+#include <indium/render-command-encoder.private.hpp>
+#include <indium/command-buffer.private.hpp>
+#include <indium/render-pass.hpp>
+#include <indium/submit-thread.private.hpp>
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <dlfcn.h>
+#include <memory>
+#include <mutex>
+#include <vector>
+#include <unistd.h>
+#include <cstring>
+#include <cstdlib>
+
+namespace Indium {
+	namespace AsyncEncode {
+		inline bool enabled() {
+			static std::atomic<bool> value {false};
+			static std::atomic<unsigned> calls {0};
+			// On by default in the League game process only (fight A/B 2026-10-12: 60.4 -> 72.4 fps, p99 28.7 -> 22.9 ms
+			// with the frame-end sync in PrivateCommandBuffer::commit). Guest flag files, re-read every 256 calls:
+			// /tmp/metal-no-async-encode turns it off there, /tmp/metal-async-encode turns it on in any process.
+			static const bool leagueGame = [] { const char* name = getprogname(); return name && strcmp(name, "LeagueofLegends") == 0; }();
+			if ((calls.fetch_add(1, std::memory_order_relaxed) & 255) == 0)
+				value.store(access("/tmp/metal-async-encode", F_OK) == 0 ||
+					(leagueGame && access("/tmp/metal-no-async-encode", F_OK) != 0), std::memory_order_relaxed);
+			return value.load(std::memory_order_relaxed);
+		}
+
+		// Objective-C autorelease pool for the worker thread (libobjc is not a link dependency of Indium)
+		struct PoolScope {
+			void* token = nullptr;
+			void (*pop)(void*) = nullptr;
+			PoolScope() {
+				static void* (*push)(void) = reinterpret_cast<void* (*)(void)>(dlsym(RTLD_DEFAULT, "objc_autoreleasePoolPush"));
+				static void (*popFn)(void*) = reinterpret_cast<void (*)(void*)>(dlsym(RTLD_DEFAULT, "objc_autoreleasePoolPop"));
+				if (push && popFn) { token = push(); pop = popFn; }
+			}
+			~PoolScope() { if (pop) pop(token); }
+		};
+
+		enum class Kind: uint8_t {
+			SetPipeline, FrontFacing, CullMode, DepthBias, DepthClip, Viewports, Scissors, BlendColor, DepthStencil, FillMode,
+			StencilRef, StencilRefFB, VisibilityMode,
+			DrawPrim, DrawIdx,
+			VBytes, VBuffer, VBufferOffset, VSampler, VSamplerClamp, VTexture,
+			FBytes, FBuffer, FBufferOffset, FSampler, FSamplerClamp, FTexture,
+			UseResource, UseResourceStages, MemoryBarrier,
+		};
+
+		struct Op {
+			Kind kind;
+			uint8_t pad8 = 0;
+			uint32_t e1 = 0, e2 = 0;
+			size_t n[5] = {0, 0, 0, 0, 0};
+			float f[4] = {0, 0, 0, 0};
+			std::shared_ptr<void> p;
+			explicit Op(Kind k) : kind(k) {}
+		};
+
+		// Recording buffers are recycled: growing them through the allocator on every encoder is what this is avoiding.
+		struct Buffers {
+			std::vector<Op> ops;
+			std::vector<uint8_t> bytes;
+			std::vector<Viewport> viewports;
+			std::vector<ScissorRect> scissors;
+			void clear() { ops.clear(); bytes.clear(); viewports.clear(); scissors.clear(); }
+		};
+
+		struct BufferPool {
+			std::mutex mutex;
+			std::vector<std::unique_ptr<Buffers>> free;
+		};
+
+		inline BufferPool& bufferPool() {
+			// The detached worker may return buffers during process teardown.
+			static auto* pool = new BufferPool;
+			return *pool;
+		}
+
+		inline std::unique_ptr<Buffers> acquireBuffers() {
+			auto& pool = bufferPool();
+			{
+				std::lock_guard<std::mutex> lock(pool.mutex);
+				if (!pool.free.empty()) { auto b = std::move(pool.free.back()); pool.free.pop_back(); return b; }
+			}
+			auto b = std::make_unique<Buffers>();
+			b->ops.reserve(512);
+			b->bytes.reserve(8192);
+			return b;
+		}
+
+		inline void releaseBuffers(std::unique_ptr<Buffers> b) {
+			b->clear();
+			if (b->ops.capacity() > 65536 || b->bytes.capacity() > 1048576) return;
+			auto& pool = bufferPool();
+			std::lock_guard<std::mutex> lock(pool.mutex);
+			if (pool.free.size() < 16) pool.free.push_back(std::move(b));
+		}
+
+		// One render pass being recorded. The recording is handed to the worker in chunks while the caller is still
+		// encoding (see DeferredRenderCommandEncoder::add), so `real` and `failed` are only touched by the worker.
+		struct State {
+			std::shared_ptr<PrivateCommandBuffer> commandBuffer;
+			RenderPassDescriptor descriptor;
+			std::shared_ptr<PrivateRenderCommandEncoder> real;
+			bool failed = false;
+			State(std::shared_ptr<PrivateCommandBuffer> cb, const RenderPassDescriptor& d) : commandBuffer(std::move(cb)), descriptor(d) {}
+		};
+
+		// Apply one chunk of recorded calls; `last` also ends the real encoder.
+		inline void replay(State& st, const Buffers& r, bool last) {
+			PoolScope pool;
+			if (!st.real && !st.failed) {
+				try {
+					st.real = st.commandBuffer->renderCommandEncoderNow(st.descriptor);
+				} catch (const std::exception& e) {
+					st.failed = true;
+					if (FILE* f = fopen("/tmp/metal-trace.log", "a")) { fprintf(f, "async-encode: encoder creation failed: %s\n", e.what()); fclose(f); }
+				}
+			}
+			if (!st.real) return;
+			PrivateRenderCommandEncoder* real = st.real.get();
+			for (const Op& op : r.ops) {
+				try {
+					switch (op.kind) {
+						case Kind::SetPipeline: real->setRenderPipelineState(std::static_pointer_cast<RenderPipelineState>(op.p)); break;
+						case Kind::FrontFacing: real->setFrontFacingWinding(static_cast<Winding>(op.e1)); break;
+						case Kind::CullMode: real->setCullMode(static_cast<CullMode>(op.e1)); break;
+						case Kind::DepthBias: real->setDepthBias(op.f[0], op.f[1], op.f[2]); break;
+						case Kind::DepthClip: real->setDepthClipMode(static_cast<DepthClipMode>(op.e1)); break;
+						case Kind::Viewports: real->setViewports(r.viewports.data() + op.n[0], op.n[1]); break;
+						case Kind::Scissors: real->setScissorRects(r.scissors.data() + op.n[0], op.n[1]); break;
+						case Kind::BlendColor: real->setBlendColor(op.f[0], op.f[1], op.f[2], op.f[3]); break;
+						case Kind::DepthStencil: real->setDepthStencilState(std::static_pointer_cast<DepthStencilState>(op.p)); break;
+						case Kind::FillMode: real->setTriangleFillMode(static_cast<TriangleFillMode>(op.e1)); break;
+						case Kind::StencilRef: real->setStencilReferenceValue(op.e1); break;
+						case Kind::StencilRefFB: real->setStencilReferenceValue(op.e1, op.e2); break;
+						case Kind::VisibilityMode: real->setVisibilityResultMode(static_cast<VisibilityResultMode>(op.e1), op.n[0]); break;
+						case Kind::DrawPrim: real->drawPrimitives(static_cast<PrimitiveType>(op.e1), op.n[0], op.n[1], op.n[2], op.n[3]); break;
+						case Kind::DrawIdx:
+							real->drawIndexedPrimitives(static_cast<PrimitiveType>(op.e1), op.n[0], static_cast<IndexType>(op.e2),
+								std::static_pointer_cast<Buffer>(op.p), op.n[1], op.n[2], static_cast<int64_t>(op.n[3]), op.n[4]);
+							break;
+						case Kind::VBytes: real->setVertexBytes(r.bytes.data() + op.n[0], op.n[1], op.n[2]); break;
+						case Kind::VBuffer: real->setVertexBuffer(std::static_pointer_cast<Buffer>(op.p), op.n[0], op.n[1]); break;
+						case Kind::VBufferOffset: real->setVertexBufferOffset(op.n[0], op.n[1]); break;
+						case Kind::VSampler: real->setVertexSamplerState(std::static_pointer_cast<SamplerState>(op.p), op.n[0]); break;
+						case Kind::VSamplerClamp: real->setVertexSamplerState(std::static_pointer_cast<SamplerState>(op.p), op.f[0], op.f[1], op.n[0]); break;
+						case Kind::VTexture: real->setVertexTexture(std::static_pointer_cast<Texture>(op.p), op.n[0]); break;
+						case Kind::FBytes: real->setFragmentBytes(r.bytes.data() + op.n[0], op.n[1], op.n[2]); break;
+						case Kind::FBuffer: real->setFragmentBuffer(std::static_pointer_cast<Buffer>(op.p), op.n[0], op.n[1]); break;
+						case Kind::FBufferOffset: real->setFragmentBufferOffset(op.n[0], op.n[1]); break;
+						case Kind::FSampler: real->setFragmentSamplerState(std::static_pointer_cast<SamplerState>(op.p), op.n[0]); break;
+						case Kind::FSamplerClamp: real->setFragmentSamplerState(std::static_pointer_cast<SamplerState>(op.p), op.f[0], op.f[1], op.n[0]); break;
+						case Kind::FTexture: real->setFragmentTexture(std::static_pointer_cast<Texture>(op.p), op.n[0]); break;
+						case Kind::UseResource: real->useResource(std::static_pointer_cast<Resource>(op.p), static_cast<ResourceUsage>(op.e1)); break;
+						case Kind::UseResourceStages: real->useResource(std::static_pointer_cast<Resource>(op.p), static_cast<ResourceUsage>(op.e1), static_cast<RenderStages>(op.n[0])); break;
+						case Kind::MemoryBarrier: real->memoryBarrier(op.n[0], static_cast<RenderStages>(op.n[1]), static_cast<RenderStages>(op.n[2])); break;
+					}
+				} catch (const std::exception& e) {
+					if (FILE* f = fopen("/tmp/metal-trace.log", "a")) { fprintf(f, "async-encode: op %d failed: %s\n", (int) op.kind, e.what()); fclose(f); }
+				}
+			}
+			if (last) {
+				try { real->endEncoding(); } catch (...) {}
+				st.real.reset();
+			}
+		}
+
+		class DeferredRenderCommandEncoder final: public RenderCommandEncoder {
+			// calls per chunk handed to the worker while the pass is still being recorded
+			static constexpr size_t chunkOps = 128;
+
+			std::shared_ptr<State> _state;
+			std::unique_ptr<Buffers> _rec;
+			Buffers* _r;
+			bool _begun = false;
+			bool _ended = false;
+
+			// The worker starts on a pass as soon as its first chunk is complete instead of after endEncoding: at the
+			// frame-end sync it used to have the whole last pass still to do while the caller waited (27% of the main
+			// thread in fights). A chunk owns the bytes/viewports/scissors its calls refer to, so any boundary is valid.
+			void flush(bool last) {
+				auto st = _state;
+				auto cb = st->commandBuffer;
+				if (!_begun) { _begun = true; cb->deferredBegin(); }
+				Buffers* chunk = _rec.release();
+				if (!cb->replayAllowed()) {
+					// an encoder dropped after the commit (a Metal contract violation): the Vulkan command buffer is
+					// closed, so drop the chunk instead of recording into it, and balance the deferred count
+					releaseBuffers(std::unique_ptr<Buffers>(chunk));
+					if (last) {
+						cb->deferredEnd();
+						st.reset();
+					}
+					if (!last) { _rec = acquireBuffers(); _r = _rec.get(); }
+					else _r = nullptr;
+					return;
+				}
+				SubmitThread::post([st, cb, chunk, last]() mutable {
+					std::unique_ptr<Buffers> owned(chunk);
+					replay(*st, *owned, last);
+					releaseBuffers(std::move(owned));
+					if (last) {
+						st.reset();
+						cb->deferredEnd();
+					}
+				});
+				if (!last) { _rec = acquireBuffers(); _r = _rec.get(); }
+				else _r = nullptr;
+			}
+
+			Op& add(Kind k) {
+				// before recording the next call: the previous ones are complete (their fields are filled in after add())
+				if (_r->ops.size() >= chunkOps) flush(false);
+				_r->ops.emplace_back(k);
+				return _r->ops.back();
+			}
+			// The op keeps the resource alive until the worker replays it; taking the reference
+			// straight from the caller's shared_ptr (the setters now take it by const reference)
+			// costs exactly one increment and no temporary, where the by-value form left an
+			// increment/decrement pair plus a store-to-load chain per forwarded bind.
+			template<class T>
+			void addRef(Kind k, const std::shared_ptr<T>& ref, size_t a, size_t b) { Op& o = add(k); o.p = ref; o.n[0] = a; o.n[1] = b; }
+
+		public:
+			DeferredRenderCommandEncoder(std::shared_ptr<PrivateCommandBuffer> cb, const RenderPassDescriptor& d):
+				_state(std::make_shared<State>(std::move(cb), d)), _rec(acquireBuffers()), _r(_rec.get()) {}
+
+			~DeferredRenderCommandEncoder() override { endEncoding(); }
+
+			void endEncoding() override {
+				if (_ended) return;
+				_ended = true;
+				flush(true);
+				_state.reset();
+			}
+
+			void setRenderPipelineState(const std::shared_ptr<RenderPipelineState>& s) override { addRef(Kind::SetPipeline, s, 0, 0); }
+			void setFrontFacingWinding(Winding w) override { add(Kind::FrontFacing).e1 = static_cast<uint32_t>(w); }
+			void setCullMode(CullMode m) override { add(Kind::CullMode).e1 = static_cast<uint32_t>(m); }
+			void setDepthBias(float bias, float slope, float clamp) override { Op& o = add(Kind::DepthBias); o.f[0] = bias; o.f[1] = slope; o.f[2] = clamp; }
+			void setDepthClipMode(DepthClipMode m) override { add(Kind::DepthClip).e1 = static_cast<uint32_t>(m); }
+			void setViewport(const Viewport& v) override { setViewports(&v, 1); }
+			void setViewports(const Viewport* v, size_t count) override {
+				Op& o = add(Kind::Viewports); o.n[0] = _r->viewports.size(); o.n[1] = count;
+				_r->viewports.insert(_r->viewports.end(), v, v + count);
+			}
+			void setViewports(const std::vector<Viewport>& v) override { setViewports(v.data(), v.size()); }
+			void setScissorRect(const ScissorRect& s) override { setScissorRects(&s, 1); }
+			void setScissorRects(const ScissorRect* s, size_t count) override {
+				Op& o = add(Kind::Scissors); o.n[0] = _r->scissors.size(); o.n[1] = count;
+				_r->scissors.insert(_r->scissors.end(), s, s + count);
+			}
+			void setScissorRects(const std::vector<ScissorRect>& s) override { setScissorRects(s.data(), s.size()); }
+			void setBlendColor(float r, float g, float b, float a) override { Op& o = add(Kind::BlendColor); o.f[0] = r; o.f[1] = g; o.f[2] = b; o.f[3] = a; }
+			void setDepthStencilState(const std::shared_ptr<DepthStencilState>& s) override { addRef(Kind::DepthStencil, s, 0, 0); }
+			void setTriangleFillMode(TriangleFillMode m) override { add(Kind::FillMode).e1 = static_cast<uint32_t>(m); }
+			void setStencilReferenceValue(uint32_t v) override { add(Kind::StencilRef).e1 = v; }
+			void setStencilReferenceValue(uint32_t front, uint32_t back) override { Op& o = add(Kind::StencilRefFB); o.e1 = front; o.e2 = back; }
+			void setVisibilityResultMode(VisibilityResultMode m, size_t offset) override { Op& o = add(Kind::VisibilityMode); o.e1 = static_cast<uint32_t>(m); o.n[0] = offset; }
+
+			void drawPrimitives(PrimitiveType t, size_t start, size_t count, size_t instances, size_t baseInstance) override {
+				Op& o = add(Kind::DrawPrim); o.e1 = static_cast<uint32_t>(t); o.n[0] = start; o.n[1] = count; o.n[2] = instances; o.n[3] = baseInstance;
+			}
+			void drawPrimitives(PrimitiveType t, size_t start, size_t count, size_t instances) override { drawPrimitives(t, start, count, instances, 0); }
+			void drawPrimitives(PrimitiveType t, size_t start, size_t count) override { drawPrimitives(t, start, count, 1, 0); }
+
+			void drawIndexedPrimitives(PrimitiveType t, size_t indexCount, IndexType it, const std::shared_ptr<Buffer>& indexBuffer, size_t indexBufferOffset,
+					size_t instanceCount, int64_t baseVertex, size_t baseInstance) override {
+				Op& o = add(Kind::DrawIdx);
+				o.e1 = static_cast<uint32_t>(t); o.e2 = static_cast<uint32_t>(it); o.p = indexBuffer;
+				o.n[0] = indexCount; o.n[1] = indexBufferOffset; o.n[2] = instanceCount; o.n[3] = static_cast<size_t>(baseVertex); o.n[4] = baseInstance;
+			}
+			void drawIndexedPrimitives(PrimitiveType t, size_t indexCount, IndexType it, const std::shared_ptr<Buffer>& b, size_t off, size_t instances) override {
+				drawIndexedPrimitives(t, indexCount, it, b, off, instances, 0, 0);
+			}
+			void drawIndexedPrimitives(PrimitiveType t, size_t indexCount, IndexType it, const std::shared_ptr<Buffer>& b, size_t off) override {
