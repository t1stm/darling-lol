+							case BlitKind::TextureToTexture:
+								real->copy(std::static_pointer_cast<Texture>(op.source), std::static_pointer_cast<Texture>(op.destination));
+								break;
+							case BlitKind::TextureToTextureLevels:
+								real->copy(std::static_pointer_cast<Texture>(op.source), op.n[0], op.n[1],
+									std::static_pointer_cast<Texture>(op.destination), op.n[2], op.n[3], op.n[4], op.n[5]);
+								break;
+							case BlitKind::TextureToTextureRegion:
+								real->copy(std::static_pointer_cast<Texture>(op.source), op.n[0], op.n[1], op.origin, op.size,
+									std::static_pointer_cast<Texture>(op.destination), op.n[2], op.n[3], op.destinationOrigin);
+								break;
+							case BlitKind::Mipmaps:
+								real->generateMipmapsForTexture(std::static_pointer_cast<Texture>(op.source));
+								break;
+							case BlitKind::FillBuffer:
+								real->fillBuffer(std::static_pointer_cast<Buffer>(op.source), op.range, op.value);
+								break;
+						}
+					} catch (const std::exception& e) {
+						if (FILE* f = fopen("/tmp/metal-trace.log", "a")) { fprintf(f, "async-blit: op %d failed: %s\n", (int) op.kind, e.what()); fclose(f); }
+					}
+				}
+				try { real->endEncoding(); } catch (...) {}
+				st.real.reset();
+			}
+		}
+
+		class DeferredBlitCommandEncoder final: public BlitCommandEncoder {
+			std::shared_ptr<BlitState> _state;
+			std::vector<BlitOp> _ops;
+			bool _begun = false;
+			bool _ended = false;
+
+			// Hand everything recorded so far to the worker. The ops own the resources they reference, so the game may
+			// release them (and us) as soon as this returns.
+			void flush() {
+				auto st = _state;
+				auto cb = st->commandBuffer;
+				if (!_begun) { _begun = true; cb->deferredBegin(); }
+				auto ops = std::make_shared<std::vector<BlitOp>>(std::move(_ops));
+				_ops.clear();
+				if (!cb->replayAllowed()) {
+					// an encoder dropped after the commit: the Vulkan command buffer is closed, so balance the deferred
+					// count and drop the ops instead of recording into it
+					blitLog("encoder dropped after commit");
+					cb->deferredEnd();
+					return;
+				}
+				SubmitThread::post([st, cb, ops]() mutable {
+					replayBlit(*st, *ops);
+					st.reset();
+					cb->deferredEnd();
+				});
+			}
+
+			BlitOp& add(BlitKind kind) {
+				_ops.emplace_back();
+				BlitOp& op = _ops.back();
+				op.kind = kind;
+				return op;
+			}
+
+		public:
+			DeferredBlitCommandEncoder(std::shared_ptr<PrivateCommandBuffer> cb, const BlitPassDescriptor& d):
+				_state(std::make_shared<BlitState>(std::move(cb), d)) {}
+			explicit DeferredBlitCommandEncoder(std::shared_ptr<PrivateCommandBuffer> cb):
+				DeferredBlitCommandEncoder(std::move(cb), BlitPassDescriptor {}) {}
+
+			~DeferredBlitCommandEncoder() override { endEncoding(); }
+
+			void endEncoding() override {
+				if (_ended) return;
+				_ended = true;
+				flush();
+				_state.reset();
+			}
+
+			// The real encoder rejects blit options; doing it here keeps the exception on the calling thread.
+			static void rejectOptions(BlitOption options) {
+				if (options != BlitOption::None) throw std::runtime_error("TODO: support blit options");
+			}
+
+			void copy(const std::shared_ptr<Buffer>& source, size_t sourceOffset, const std::shared_ptr<Buffer>& destination, size_t destinationOffset, size_t size) override {
+				BlitOp& op = add(BlitKind::BufferToBuffer);
+				op.source = source; op.destination = destination;
+				op.n[0] = sourceOffset; op.n[1] = destinationOffset; op.n[2] = size;
+			}
+			void copy(const std::shared_ptr<Buffer>& source, size_t sourceOffset, size_t sourceBytesPerRow, size_t sourceBytesPerImage, Size sourceSize, const std::shared_ptr<Texture>& destination, size_t destinationSlice, size_t destinationLevel, Origin destinationOrigin, BlitOption options = BlitOption::None) override {
+				rejectOptions(options);
+				BlitOp& op = add(BlitKind::BufferToTexture);
+				op.source = source; op.destination = destination;
+				op.n[0] = sourceOffset; op.n[1] = sourceBytesPerRow; op.n[2] = sourceBytesPerImage;
+				op.n[3] = destinationSlice; op.n[4] = destinationLevel;
+				op.origin = destinationOrigin; op.size = sourceSize;
+			}
+			void copy(const std::shared_ptr<Texture>& source, size_t sourceSlice, size_t sourceLevel, Origin sourceOrigin, Size sourceSize, const std::shared_ptr<Buffer>& destination, size_t destinationOffset, size_t destinationBytesPerRow, size_t destinationBytesPerImage, BlitOption options = BlitOption::None) override {
+				rejectOptions(options);
+				BlitOp& op = add(BlitKind::TextureToBuffer);
+				op.source = source; op.destination = destination;
+				op.n[0] = sourceSlice; op.n[1] = sourceLevel;
+				op.n[2] = destinationOffset; op.n[3] = destinationBytesPerRow; op.n[4] = destinationBytesPerImage;
+				op.origin = sourceOrigin; op.size = sourceSize;
+			}
+			void copy(const std::shared_ptr<Texture>& source, const std::shared_ptr<Texture>& destination) override {
+				BlitOp& op = add(BlitKind::TextureToTexture);
+				op.source = source; op.destination = destination;
+			}
+			void copy(const std::shared_ptr<Texture>& source, size_t sourceSlice, size_t sourceLevel, const std::shared_ptr<Texture>& destination, size_t destinationSlice, size_t destinationLevel, size_t sliceCount, size_t levelCount) override {
+				BlitOp& op = add(BlitKind::TextureToTextureLevels);
+				op.source = source; op.destination = destination;
+				op.n[0] = sourceSlice; op.n[1] = sourceLevel; op.n[2] = destinationSlice; op.n[3] = destinationLevel;
+				op.n[4] = sliceCount; op.n[5] = levelCount;
+			}
+			void copy(const std::shared_ptr<Texture>& source, size_t sourceSlice, size_t sourceLevel, Origin sourceOrigin, Size sourceSize, const std::shared_ptr<Texture>& destination, size_t destinationSlice, size_t destinationLevel, Origin destinationOrigin) override {
+				BlitOp& op = add(BlitKind::TextureToTextureRegion);
+				op.source = source; op.destination = destination;
+				op.n[0] = sourceSlice; op.n[1] = sourceLevel; op.n[2] = destinationSlice; op.n[3] = destinationLevel;
+				op.origin = sourceOrigin; op.destinationOrigin = destinationOrigin; op.size = sourceSize;
+			}
+			void fillBuffer(const std::shared_ptr<Buffer>& buffer, Range<size_t> range, uint8_t value) override {
+				// the real encoder rejects misaligned ranges; keep the exception on the calling thread
+				if ((range.start & 3) != 0) throw std::runtime_error("Misaligned fillBuffer offset");
+				if ((range.length & 3) != 0) throw std::runtime_error("Misaligned fillBuffer length");
+				BlitOp& op = add(BlitKind::FillBuffer);
+				op.source = buffer;
+				op.range = range;
+				op.value = value;
+			}
+			void generateMipmapsForTexture(const std::shared_ptr<Texture>& texture) override {
+				BlitOp& op = add(BlitKind::Mipmaps);
+				op.source = texture;
+			}
+		};
+	}
+}
