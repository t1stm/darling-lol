+			void setVertexTextures(const std::vector<std::shared_ptr<Texture>>& t, Range<size_t> r) override {
+				for (size_t i = 0; i < r.length; ++i) addRef(Kind::VTexture, t[i], r.start + i, 0);
+			}
+
+			void setFragmentBytes(const void* bytes, size_t length, size_t index) override {
+				Op& o = add(Kind::FBytes); o.n[0] = _r->bytes.size(); o.n[1] = length; o.n[2] = index;
+				const auto* p = static_cast<const uint8_t*>(bytes);
+				_r->bytes.insert(_r->bytes.end(), p, p + length);
+			}
+			void setFragmentBuffer(const std::shared_ptr<Buffer>& b, size_t offset, size_t index) override { addRef(Kind::FBuffer, b, offset, index); }
+			void setFragmentBuffers(const std::vector<std::shared_ptr<Buffer>>& b, const std::vector<size_t>& o, Range<size_t> r) override {
+				for (size_t i = 0; i < r.length; ++i) addRef(Kind::FBuffer, b[i], o[i], r.start + i);
+			}
+			void setFragmentBufferOffset(size_t offset, size_t index) override { Op& o = add(Kind::FBufferOffset); o.n[0] = offset; o.n[1] = index; }
+			void setFragmentSamplerState(const std::shared_ptr<SamplerState>& s, size_t index) override { addRef(Kind::FSampler, s, index, 0); }
+			void setFragmentSamplerState(const std::shared_ptr<SamplerState>& s, float lo, float hi, size_t index) override {
+				Op& o = add(Kind::FSamplerClamp); o.p = s; o.f[0] = lo; o.f[1] = hi; o.n[0] = index;
+			}
+			void setFragmentSamplerStates(const std::vector<std::shared_ptr<SamplerState>>& s, Range<size_t> r) override {
+				for (size_t i = 0; i < r.length; ++i) setFragmentSamplerState(s[i], r.start + i);
+			}
+			void setFragmentSamplerStates(const std::vector<std::shared_ptr<SamplerState>>& s, const std::vector<float>& lo, const std::vector<float>& hi, Range<size_t> r) override {
+				for (size_t i = 0; i < r.length; ++i) setFragmentSamplerState(s[i], lo[i], hi[i], r.start + i);
+			}
+			void setFragmentTexture(const std::shared_ptr<Texture>& t, size_t index) override { addRef(Kind::FTexture, t, index, 0); }
+			void setFragmentTextures(std::vector<std::shared_ptr<Texture>>& t, Range<size_t> r) override {
+				for (size_t i = 0; i < r.length; ++i) addRef(Kind::FTexture, t[i], r.start + i, 0);
+			}
+
+			void useResource(std::shared_ptr<Resource> res, ResourceUsage usage, RenderStages stages) override {
+				Op& o = add(Kind::UseResourceStages); o.p = std::move(res); o.e1 = static_cast<uint32_t>(usage); o.n[0] = static_cast<size_t>(stages);
+			}
+			void useResources(const std::vector<std::shared_ptr<Resource>>& res, ResourceUsage usage, RenderStages stages) override {
+				// one op per resource: the real encoder batches barriers per call, which only affects how they are grouped
+				for (const auto& r : res) useResource(r, usage, stages);
+			}
+			void useResource(std::shared_ptr<Resource> res, ResourceUsage usage) override {
+				Op& o = add(Kind::UseResource); o.p = std::move(res); o.e1 = static_cast<uint32_t>(usage);
+			}
+			void useResources(const std::vector<std::shared_ptr<Resource>>& res, ResourceUsage usage) override {
+				for (const auto& r : res) useResource(r, usage);
+			}
+			void memoryBarrier(size_t scope, RenderStages after, RenderStages before) override {
+				Op& o = add(Kind::MemoryBarrier); o.n[0] = scope; o.n[1] = static_cast<size_t>(after); o.n[2] = static_cast<size_t>(before);
+			}
+		};
+	}
+}
