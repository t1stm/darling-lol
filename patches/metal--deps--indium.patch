+// Texture creation (layout transition) and replaceRegion (staging copy) each submit a one-shot command buffer. They used to
+// wait for its fence, and that fence only signals once the GPU has also finished everything submitted before it: in a League
+// fight the main thread spent 5.7% of its time in that wait (DRM_IOCTL_SYNCOBJ_WAIT, sampled 2026-10-10). The work is ordered
+// by the queue, so later command buffers see its result without anyone waiting; only the one-shot buffer, its fence and the
+// staging buffer have to outlive it. They are parked here and released once their fence has signalled.
+// MEASURED SLOWER and therefore OFF by default: three interleaved fight pairs gave 81.6/78.1/78.4 fps without the wait
+// against 84.9/81.9/81.7 with it (2026-10-10, GPU 95-97% busy, so the wait was not costing throughput).
+// Guest file /tmp/metal-async-uploads enables it (re-read every 64 one-shot submissions).
+namespace {
+	struct PendingOneshot {
+		VkFence fence;
+		VkCommandBuffer commandBuffer;
+		VkImage image;
+		std::shared_ptr<void> keepAlive;
+	};
+
+	// guarded by the device's oneshotCommandPoolMutex
+	std::deque<PendingOneshot>& pendingOneshots() {
+		static auto* list = new std::deque<PendingOneshot>;
+		return *list;
+	}
+
+	bool syncUploads() {
+		static std::atomic<bool> sync {true};
+		static std::atomic<unsigned> calls {0};
+		if ((calls.fetch_add(1, std::memory_order_relaxed) & 63) == 0)
+			sync.store(access("/tmp/metal-async-uploads", F_OK) != 0, std::memory_order_relaxed);
+		return sync.load(std::memory_order_relaxed);
+	}
+
+	void releaseOneshot(const std::shared_ptr<Indium::PrivateDevice>& device, PendingOneshot& entry) {
+		Indium::DynamicVK::vkDestroyFence(device->device(), entry.fence, nullptr);
+		Indium::DynamicVK::vkFreeCommandBuffers(device->device(), device->oneshotCommandPool(), 1, &entry.commandBuffer);
+	}
+
+	// caller holds the pool mutex. Releases finished entries in submission order; with `through` set, waits for and releases
+	// everything up to the last entry that uses that image (the image is about to be destroyed).
+	void retireOneshots(const std::shared_ptr<Indium::PrivateDevice>& device, VkImage through = VK_NULL_HANDLE) {
+		auto& list = pendingOneshots();
+		size_t mustWait = 0;
+		if (through != VK_NULL_HANDLE) {
+			for (size_t i = 0; i < list.size(); ++i) if (list[i].image == through) mustWait = i + 1;
+		}
+		if (list.size() > 512 && mustWait < list.size() - 512) mustWait = list.size() - 512; // bounded backlog
+		while (!list.empty()) {
+			auto& front = list.front();
+			if (mustWait > 0) {
+				Indium::Waits::Block block("oneshotFence");
+				if (Indium::DynamicVK::vkWaitForFences(device->device(), 1, &front.fence, VK_TRUE, 1ull * 1000 * 1000 * 1000) != VK_SUCCESS) abort();
+				--mustWait;
+			} else if (Indium::DynamicVK::vkWaitForFences(device->device(), 1, &front.fence, VK_TRUE, 0) != VK_SUCCESS) { // zero timeout: a status poll
+				break;
+			}
+			releaseOneshot(device, front);
+			list.pop_front();
+		}
+	}
+
+	// caller holds the pool mutex and has submitted `commandBuffer` with `fence`
+	void finishOneshot(const std::shared_ptr<Indium::PrivateDevice>& device, VkFence fence, VkCommandBuffer commandBuffer, VkImage image, std::shared_ptr<void> keepAlive) {
+		PendingOneshot entry {fence, commandBuffer, image, std::move(keepAlive)};
+		if (syncUploads()) {
+			// this is a GPU wait on the uploading thread; counted under /tmp/metal-debug-waits like the hand-off waits
+			Indium::Waits::Block block("oneshotFence");
+			if (Indium::DynamicVK::vkWaitForFences(device->device(), 1, &fence, VK_TRUE, 1ull * 1000 * 1000 * 1000) != VK_SUCCESS) abort();
