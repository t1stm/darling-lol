+#pragma once
+
+// Deferred blit-command encoding.
+//
+// A blit encoder used to record its vkCmd* calls (and their barriers) directly into the command buffer, on the game's
+// thread, after waiting for every pending render replay of that command buffer (PrivateCommandBuffer::waitDeferred()).
+// Both the wait and the driver calls are on the frame's critical path, and nothing about them has to happen there:
+// Metal only requires that the calls are applied in order before the command buffer is committed.
+//
+// This facade implements the same public BlitCommandEncoder interface by recording the calls into a compact op list
+// (holding a reference to every buffer and texture they mention) and, at endEncoding(), posting the list to the ordered
+// worker of submit-thread.private.hpp -- the same FIFO the deferred render chunks and the commit itself run on. The
+// real PrivateBlitCommandEncoder is created, fed and ended there, in command-buffer order, before the commit that
+// closes the Vulkan command buffer. The deferred count keeps waitDeferred() correct for anything that still records
+// directly (compute encoders, and every encoder while deferred render encoding is off).
+//
+// Only used while deferred render encoding is on: with it off, render encoders record into the Vulkan command buffer
+// on the calling thread, so a blit replay has to stay on that thread too (the direct path keeps its waitDeferred()).
+// OFF by default (round-3 behaviour: blit encoders record directly on the calling thread after waitDeferred()). Guest
+// flag file /tmp/metal-deferred-blit (checked once per process) turns the facade on. Round 4 had it on by default; that
+// round regressed in matches, so it is an opt-in experiment now.
+
+#include <indium/blit-command-encoder.private.hpp>
+#include <indium/buffer.hpp>
+#include <indium/command-buffer.private.hpp>
+#include <indium/submit-thread.private.hpp>
+#include <indium/texture.hpp>
+
+#include <atomic>
+#include <cstdio>
+#include <memory>
+#include <stdexcept>
+#include <unistd.h>
+#include <vector>
+
+namespace Indium {
+	namespace AsyncEncode {
+		inline bool deferBlitEnabled() {
+			static const bool value = access("/tmp/metal-deferred-blit", F_OK) == 0;
+			return value;
+		}
+
+		// Blits are short lists of large operations; one chunk per encoder (posted at endEncoding) is enough, and it
+		// keeps the whole pass on one worker task, i.e. in one command-buffer order.
+		enum class BlitKind: uint8_t {
+			BufferToBuffer, BufferToTexture, TextureToBuffer, TextureToTexture, TextureToTextureLevels, TextureToTextureRegion, Mipmaps, FillBuffer,
+		};
+
+		struct BlitOp {
+			BlitKind kind = BlitKind::BufferToBuffer;
+			uint8_t value = 0;
+			// per-kind arguments, in the order of the call (offsets, slices, levels, row/image strides)
+			size_t n[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+			Origin origin {};
+			Origin destinationOrigin {};
+			Size size {};
+			Range<size_t> range {0, 0};
+			std::shared_ptr<void> source;
+			std::shared_ptr<void> destination;
+		};
+
+		// One blit pass being recorded. `real` and `failed` are only touched by the worker.
+		struct BlitState {
+			std::shared_ptr<PrivateCommandBuffer> commandBuffer;
+			BlitPassDescriptor descriptor;
+			std::shared_ptr<PrivateBlitCommandEncoder> real;
+			bool failed = false;
+			BlitState(std::shared_ptr<PrivateCommandBuffer> cb, const BlitPassDescriptor& d): commandBuffer(std::move(cb)), descriptor(d) {}
+		};
+
+		inline void blitLog(const char* message) {
+			if (FILE* f = fopen("/tmp/metal-trace.log", "a")) {
+				fprintf(f, "async-blit: %s\n", message);
+				fclose(f);
+			}
+		}
