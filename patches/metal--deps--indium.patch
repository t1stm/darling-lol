diff --git a/private-include/indium/memory-pool.private.hpp b/private-include/indium/memory-pool.private.hpp
new file mode 100644
index 0000000..a7d31ee
--- /dev/null
+++ b/private-include/indium/memory-pool.private.hpp
@@ -0,0 +1,233 @@
+#pragma once
+
+// Suballocation of device memory for buffers and textures.
+//
+// Every buffer and texture used to own a VkDeviceMemory. RADV hands the kernel the complete list of a device's memory
+// objects with every submission (required once buffer device addresses are in use), so vkQueueSubmit2 cost grew with the
+// number of live resources: about 1.1 ms per frame in League, 77% of it in amdgpu_cs_ioctl walking that list.
+// Resources up to MaxPooledSize now share 32 MB blocks; larger ones keep a dedicated allocation.
+//
+// Header-only on purpose (function-local statics, one instance per libindium) and keyed by the Vulkan handle of the
+// owning buffer/image, so no class gains a member: QuartzCore and Metal read some Indium objects at fixed offsets.
+// Create guest /tmp/metal-no-pool before the process starts to get one allocation per resource again.
+
+#include <indium/dynamic-vk.hpp>
+
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <deque>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+#include <unistd.h>
+
+namespace Indium {
+	namespace MemoryPool {
+		struct Allocation {
+			VkDeviceMemory memory = VK_NULL_HANDLE;
+			VkDeviceSize offset = 0;
+			VkDeviceSize size = 0;
+		};
+
+		namespace Detail {
+			static constexpr VkDeviceSize BlockSize = 32ull << 20;
+			static constexpr VkDeviceSize MaxPooledSize = 4ull << 20;
+			static constexpr VkDeviceSize Granule = 256;
+			// a freed range is not handed out again before this long: work already submitted to the GPU may still read it
+			static constexpr std::chrono::milliseconds Quarantine {1000};
+
+			struct Block {
+				VkDeviceMemory memory = VK_NULL_HANDLE;
+				VkDeviceSize size = 0;
+				uint32_t key = 0;
+				bool dedicated = false;
+				void* mapped = nullptr;
+				size_t live = 0;
+				std::map<VkDeviceSize, VkDeviceSize> free; // offset -> size
+			};
+
+			struct Entry {
+				std::shared_ptr<Block> block;
+				VkDeviceSize offset;
+				VkDeviceSize size;
+			};
+
+			struct Pending {
+				std::chrono::steady_clock::time_point when;
+				std::shared_ptr<Block> block;
+				VkDeviceSize offset;
+				VkDeviceSize size;
+			};
+
+			struct State {
+				std::mutex mutex;
+				std::unordered_map<uint64_t, Entry> entries;
+				std::unordered_map<uint32_t, std::vector<std::shared_ptr<Block>>> blocks;
+				std::deque<Pending> pending;
+				bool disabled = access("/tmp/metal-no-pool", F_OK) == 0;
+			};
+
+			inline State& state() {
+				static State* instance = new State; // never destroyed: resources are released during process teardown
+				return *instance;
+			}
+
+			inline VkDeviceSize alignUp(VkDeviceSize value, VkDeviceSize alignment) {
+				return (value + alignment - 1) / alignment * alignment;
+			}
+
+			inline VkDeviceMemory allocateMemory(VkDevice device, uint32_t typeIndex, VkDeviceSize size, bool deviceAddress) {
+				VkMemoryAllocateInfo info {};
+				info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+				info.allocationSize = size;
+				info.memoryTypeIndex = typeIndex;
+				VkMemoryAllocateFlagsInfo flags {};
+				flags.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO;
+				flags.flags = VK_MEMORY_ALLOCATE_DEVICE_ADDRESS_BIT;
+				if (deviceAddress) info.pNext = &flags;
+				VkDeviceMemory memory = VK_NULL_HANDLE;
+				if (DynamicVK::vkAllocateMemory(device, &info, nullptr, &memory) != VK_SUCCESS) abort();
+				return memory;
+			}
+
+			inline void releaseRange(State& s, VkDevice device, const std::shared_ptr<Block>& block, VkDeviceSize offset, VkDeviceSize size) {
+				auto next = block->free.lower_bound(offset);
+				if (next != block->free.begin()) {
+					auto previous = std::prev(next);
+					if (previous->first + previous->second == offset) {
+						offset = previous->first;
+						size += previous->second;
+						block->free.erase(previous);
+					}
+				}
+				if (next != block->free.end() && offset + size == next->first) {
+					size += next->second;
+					block->free.erase(next);
+				}
+				block->free[offset] = size;
+				if (block->live != 0 || size != block->size) return;
+				// the block is empty: keep one spare per kind, give the others back
+				auto& list = s.blocks[block->key];
+				size_t empty = 0;
+				for (const auto& other : list) {
+					if (other->live == 0 && other->free.size() == 1 && other->free.begin()->second == other->size) ++empty;
+				}
+				if (empty <= 1) return;
+				for (auto it = list.begin(); it != list.end(); ++it) {
+					if (*it == block) { list.erase(it); break; }
+				}
+				DynamicVK::vkFreeMemory(device, block->memory, nullptr);
+				block->memory = VK_NULL_HANDLE;
+			}
+
+			inline void drain(State& s, VkDevice device) {
+				auto now = std::chrono::steady_clock::now();
+				while (!s.pending.empty() && now - s.pending.front().when >= Quarantine) {
+					Pending item = std::move(s.pending.front());
+					s.pending.pop_front();
+					if (item.block->dedicated) {
+						DynamicVK::vkFreeMemory(device, item.block->memory, nullptr);
+					} else {
+						--item.block->live;
+						releaseRange(s, device, item.block, item.offset, item.size);
+					}
+				}
+			}
+		}
+
+		// `owner` is the buffer or image handle the memory will be bound to
+		inline Allocation allocate(VkDevice device, uint64_t owner, uint32_t typeIndex, VkDeviceSize size, VkDeviceSize alignment, bool image, bool deviceAddress) {
+			using namespace Detail;
+			auto& s = state();
+			std::lock_guard<std::mutex> lock(s.mutex);
+			drain(s, device);
+			Entry entry;
+			if (s.disabled || size > MaxPooledSize) {
+				entry.block = std::make_shared<Block>();
+				entry.block->dedicated = true;
+				entry.block->size = size;
+				entry.block->memory = allocateMemory(device, typeIndex, size, deviceAddress);
+				entry.offset = 0;
+				entry.size = size;
+			} else {
+				if (alignment < Granule) alignment = Granule;
+				size = alignUp(size, Granule);
+				const uint32_t key = (typeIndex << 2) | (image ? 2u : 0u) | (deviceAddress ? 1u : 0u);
+				auto& list = s.blocks[key];
+				for (int attempt = 0; attempt < 2 && !entry.block; ++attempt) {
+					for (auto& block : list) {
+						for (auto it = block->free.begin(); it != block->free.end(); ++it) {
+							VkDeviceSize start = alignUp(it->first, alignment);
+							VkDeviceSize end = it->first + it->second;
+							if (start + size > end) continue;
+							VkDeviceSize rangeStart = it->first;
+							block->free.erase(it);
+							if (start > rangeStart) block->free[rangeStart] = start - rangeStart;
+							if (start + size < end) block->free[start + size] = end - (start + size);
+							entry.block = block;
+							entry.offset = start;
+							entry.size = size;
+							++block->live;
+							break;
+						}
+						if (entry.block) break;
+					}
+					if (!entry.block && attempt == 0) {
+						auto block = std::make_shared<Block>();
+						block->key = key;
+						block->size = BlockSize;
+						block->memory = allocateMemory(device, typeIndex, BlockSize, deviceAddress);
+						block->free[0] = BlockSize;
+						list.push_back(block);
+					}
+				}
+				if (!entry.block) abort();
+			}
+			s.entries[owner] = entry;
+			return Allocation { entry.block->memory, entry.offset, entry.size };
+		}
+
+		inline bool lookup(uint64_t owner, Allocation& result) {
+			auto& s = Detail::state();
+			std::lock_guard<std::mutex> lock(s.mutex);
+			auto it = s.entries.find(owner);
+			if (it == s.entries.end()) return false;
+			result = Allocation { it->second.block->memory, it->second.offset, it->second.size };
+			return true;
+		}
+
+		// host pointer to the start of the owner's memory (the memory type must be host-visible)
+		inline void* map(VkDevice device, uint64_t owner) {
+			auto& s = Detail::state();
+			std::lock_guard<std::mutex> lock(s.mutex);
+			auto it = s.entries.find(owner);
+			if (it == s.entries.end()) return nullptr;
+			auto& block = it->second.block;
+			if (!block->mapped) {
+				if (DynamicVK::vkMapMemory(device, block->memory, 0, VK_WHOLE_SIZE, 0, &block->mapped) != VK_SUCCESS) abort();
+			}
+			return static_cast<char*>(block->mapped) + it->second.offset;
+		}
+
+		// call after the owning buffer/image has been destroyed
+		inline void free(VkDevice device, uint64_t owner) {
+			using namespace Detail;
+			auto& s = state();
+			std::lock_guard<std::mutex> lock(s.mutex);
+			auto it = s.entries.find(owner);
+			if (it == s.entries.end()) return;
+			Entry entry = std::move(it->second);
+			s.entries.erase(it);
+			if (entry.block->dedicated) {
+				// nothing can reuse a dedicated allocation, and the kernel keeps it alive for work in flight
+				DynamicVK::vkFreeMemory(device, entry.block->memory, nullptr);
+			} else {
+				s.pending.push_back(Pending { std::chrono::steady_clock::now(), entry.block, entry.offset, entry.size });
+			}
+			drain(s, device);
+		}
+	}
+}
diff --git a/private-include/indium/outline-chain.private.hpp b/private-include/indium/outline-chain.private.hpp
new file mode 100644
index 0000000..5f40789
--- /dev/null
+++ b/private-include/indium/outline-chain.private.hpp
@@ -0,0 +1,124 @@
+#pragma once
+
+// League's hover/target outline is a chain of full-screen 1080p passes that ping-pong between two textures: a mask pass,
+// then N passes with one fragment shader (SPIR-V hash 87819980) and M passes with a second (f61b5318), then a composite.
+// Every pass reads the previous result, so a pass can be dropped without breaking the data flow: the next pass simply reads
+// a result with fewer iterations applied. This keeps only the first 2*K passes of the first phase of each chain.
+//
+// Live settings (guest files, re-read every 2048 draws; create them from inside the guest):
+//   /tmp/metal-outline-pairs   K1: passes of the first phase kept = 2*K1 (default 0; 16 keeps everything)
+//   /tmp/metal-outline-pairs2  K2: passes of the second phase kept = 2*K2 (default 16 = all of them)
+// Header-only with function-local statics (no class gains a member).
+
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <unordered_map>
+#include <unistd.h>
+#include <cstdio>
+
+namespace Indium {
+	namespace OutlineChain {
+		struct State {
+			std::mutex mutex;
+			std::unordered_map<const void*, uint32_t> libraryHash;
+			std::unordered_map<const void*, uint8_t> pipelineKind; // 1 = first phase shader, 2 = second phase shader
+		};
+
+		inline State& state() {
+			static State* instance = new State;
+			return *instance;
+		}
+
+		inline void noteLibrary(const void* library, const char* data, size_t length) {
+			uint64_t h = 1469598103934665603ull;
+			for (size_t i = 0; i < length; ++i) { h ^= (unsigned char) data[i]; h *= 1099511628211ull; }
+			auto& s = state();
+			std::lock_guard<std::mutex> lock(s.mutex);
+			s.libraryHash[library] = (uint32_t) (h & 0xffffffffull);
+		}
+
+		inline void notePipeline(const void* pipeline, const void* fragmentLibrary) {
+			if (!fragmentLibrary) return;
+			auto& s = state();
+			std::lock_guard<std::mutex> lock(s.mutex);
+			auto it = s.libraryHash.find(fragmentLibrary);
+			if (it == s.libraryHash.end()) return;
+			if (it->second == 0x87819980u) s.pipelineKind[pipeline] = 1;
+			else if (it->second == 0xf61b5318u) s.pipelineKind[pipeline] = 2;
+		}
+
+		inline void readSettings(int& k1, int& k2) {
+			static std::atomic<int> v1 {0}, v2 {16};
+			static std::atomic<unsigned> calls {0};
+			if ((calls.fetch_add(1) & 2047) == 0) {   // each read is two fopen()s through Darling's path translation
+				auto read = [](const char* path, int fallback) {
+					int out = fallback;
+					if (FILE* f = fopen(path, "r")) {
+						int v = -1;
+						if (fscanf(f, "%d", &v) == 1 && v >= 0 && v <= 16) out = v;
+						fclose(f);
+					}
+					return out;
+				};
+				v1.store(read("/tmp/metal-outline-pairs", 0));
+				v2.store(read("/tmp/metal-outline-pairs2", 16));
+			}
+			k1 = v1.load();
+			k2 = v2.load();
+		}
+
+		inline void report(int k, uint8_t kind, bool skipped, size_t vertexCount) {
+			static std::atomic<unsigned long> draws {0}, kind1 {0}, kind1v4 {0}, kind2 {0}, skippedDraws {0};
+			static std::atomic<unsigned> tick {0};
+			++draws;
+			if (kind == 1) ++kind1;
+			if (kind == 1 && vertexCount == 4) ++kind1v4;
+			if (kind == 2) ++kind2;
+			if (skipped) ++skippedDraws;
+			if ((tick.fetch_add(1) & 1023) == 0) {
+				auto& s = state();
+				size_t kinds = 0, libs = 0;
+				{ std::lock_guard<std::mutex> lock(s.mutex); kinds = s.pipelineKind.size(); libs = s.libraryHash.size(); }
+				char path[64];
+				snprintf(path, sizeof(path), "/tmp/indium-outline-%d.log", (int) getpid());
+				if (FILE* f = fopen(path, "w")) {
+					fprintf(f, "k=%d draws=%lu kind1=%lu kind1_v4=%lu kind2=%lu skipped=%lu pipelineKinds=%zu libraries=%zu\n", k,
+						draws.load(), kind1.load(), kind1v4.load(), kind2.load(), skippedDraws.load(), kinds, libs);
+					fclose(f);
+				}
+			}
+		}
+
+		// called for every drawPrimitives; true: skip this draw
+		inline bool shouldSkipDraw(const void* pipeline, size_t vertexCount) {
+			static thread_local unsigned run1 = 0, run2 = 0;
+			int k1 = 0, k2 = 16;
+			readSettings(k1, k2);
+			uint8_t kind = 0;
+			{
+				auto& s = state();
+				std::lock_guard<std::mutex> lock(s.mutex);
+				auto it = s.pipelineKind.find(pipeline);
+				if (it != s.pipelineKind.end()) kind = it->second;
+			}
+			if (vertexCount != 4 || kind == 0) {
+				// any other draw ends the chain
+				run1 = run2 = 0;
+				return false;
+			}
+			bool skip;
+			if (kind == 1) {
+				// a new chain starts with its first-phase passes
+				if (run2 != 0) { run1 = run2 = 0; }
+				skip = run1 >= (unsigned) (2 * k1);
+				++run1;
+			} else {
+				skip = run2 >= (unsigned) (2 * k2);
+				++run2;
+			}
+			// report(k1, kind, skip, vertexCount);   // diagnostic: rewrote a guest log file every 1024 draws
+			return skip;
+		}
+	}
+}
