+Iridium::SPIRV::ResultID Iridium::SPIRV::Builder::declareConstantBool(bool value) {
+	auto typeID = declareType(Type(Type::BooleanTag {}));
+	auto key = std::make_pair(static_cast<uintmax_t>(value ? 1 : 0), typeID);
+	auto it = _constantBools.find(key);
+
+	if (it != _constantBools.end()) {
+		return it->second;
+	}
+
+	auto id = reserveResultID();
+
+	_constantBools.emplace(key, id);
+
+	auto tmp = beginInstruction(value ? Opcode::ConstantTrue : Opcode::ConstantFalse, _constants);
+	_constants.writeIntegerLE<uint32_t>(typeID);
+	_constants.writeIntegerLE<uint32_t>(id);
+	endInstruction(std::move(tmp));
+
+	return id;
+};
+
+Iridium::SPIRV::ResultID Iridium::SPIRV::Builder::encodeRawOp(uint16_t opcode, ResultID resultTypeID, const std::vector<ResultID>& operands) {
+	auto result = reserveResultID();
+	auto tmp = beginInstruction(opcode, *_currentFunctionWriter);
+	_currentFunctionWriter->writeIntegerLE<uint32_t>(resultTypeID);
+	_currentFunctionWriter->writeIntegerLE<uint32_t>(result);
+	for (auto operand: operands) {
+		_currentFunctionWriter->writeIntegerLE<uint32_t>(operand);
+	}
+	endInstruction(std::move(tmp));
+	return result;
+};
+
+void Iridium::SPIRV::Builder::encodeRawOpNoResult(uint16_t opcode, const std::vector<ResultID>& operands) {
+	auto tmp = beginInstruction(opcode, *_currentFunctionWriter);
+	for (auto operand: operands) {
+		_currentFunctionWriter->writeIntegerLE<uint32_t>(operand);
+	}
+	endInstruction(std::move(tmp));
+};
+
+Iridium::SPIRV::ResultID Iridium::SPIRV::Builder::encodeGLSLOp(GLSLOpcode opcode, ResultID resultTypeID, const std::vector<ResultID>& operands) {
+	auto result = reserveResultID();
+	auto tmp = beginGLSLInstruction(opcode, *_currentFunctionWriter, resultTypeID, result);
+	for (auto operand: operands) {
+		_currentFunctionWriter->writeIntegerLE<uint32_t>(operand);
+	}
+	endInstruction(std::move(tmp));
+	return result;
+};
