+#pragma once
+
+// Merging consecutive command buffer submissions into one vkQueueSubmit2 batch (see command-buffer.cpp).
+// League commits ~30 small command buffers per frame; each used to cost its own queue submit (an amdgpu CS ioctl plus
+// timeline-semaphore ioctls). Opt-in: guest flag file /tmp/metal-submit-batch (checked once).
+// A pending batch is flushed before anything that waits for or depends on submitted work (presenting commit, waitUntilCompleted,
+// texture uploads) and by a 2 ms timer.
+
+namespace Indium {
+	bool submitBatchEnabled();
+	void flushPendingSubmits();
+}
diff --git a/private-include/indium/submit-thread.private.hpp b/private-include/indium/submit-thread.private.hpp
new file mode 100644
index 0000000..06ccdaf
--- /dev/null
+++ b/private-include/indium/submit-thread.private.hpp
@@ -0,0 +1,175 @@
+#pragma once
+
+// Ordered queue-submission worker.
+//
+// PrivateCommandBuffer::commit() used to do all its Vulkan queue work (semaphore reservation, vkQueueSubmit2, drawable
+// presentation) on the game's main thread: about 1.9 ms per frame in League's Baron fight, 77% of it inside the kernel's
+// amdgpu CS ioctl. The caller thread now only finishes recording; one FIFO worker performs the queue work, so the
+// submission order equals the commit order (timeline values are reserved inside the same task, in that order).
+// Every other path that touches the graphics queue (texture uploads) calls drain() first so it cannot overtake a
+// pending commit. Opt-in: guest flag file /tmp/metal-submit-thread (checked once) enables it; the A/B showed no gain, so submission stays synchronous.
+// Header-only with function-local statics: no class gains a member.
+
+#include <indium/waits.private.hpp>
+
+#include <condition_variable>
+#include <deque>
+#include <cstdint>
+#include <limits>
+#include <functional>
+#include <mutex>
+#include <thread>
+#include <unistd.h>
+
+namespace Indium {
+	namespace SubmitThread {
+		struct State {
+			std::mutex mutex;
+			std::condition_variable wake;
+			std::condition_variable idle;
+			std::deque<std::function<void()>> queue;
+			size_t active = 0;
+			uint64_t posted = 0, completed = 0;
+			size_t drainWaiters = 0;
+			uint64_t drainTarget = std::numeric_limits<uint64_t>::max();
+			bool started = false;
+			const bool enabled = access("/tmp/metal-submit-thread", F_OK) == 0;
+		};
+
+		// One-shot completion token for a queued task: the worker signals it at the end of the task, so a caller that
+		// only has to wait for *its own* commit (the present dispatch it just queued) does not wait for the tasks that
+		// were queued after it. The token must outlive the task, which the waiting caller guarantees.
+		struct Token {
+			std::mutex mutex;
+			std::condition_variable condvar;
+			bool done = false;
+			void signal() {
+				{
+					std::lock_guard<std::mutex> lock(mutex);
+					done = true;
+					// The waiter may destroy this stack token as soon as it sees done.
+					// Finish notifying while the token's mutex still protects its lifetime.
+					condvar.notify_all();
+				}
+			}
+			// blocks until the task carrying this token has finished (counting the block under `site`)
+			void wait(const char* site) {
+				std::unique_lock<std::mutex> lock(mutex);
+				Waits::blockOn(site, condvar, lock, [this] { return done; });
+			}
+		};
+
+		inline State& state() {
+			static State* instance = new State;
+			return *instance;
+		}
+
+		inline bool& workerThread() {
+			static thread_local bool value = false;
+			return value;
+		}
+
+		inline bool onWorker() { return workerThread(); }
+
+		inline void loop() {
+			workerThread() = true;
+			auto& s = state();
+			for (;;) {
+				std::function<void()> task;
+				{
+					std::unique_lock<std::mutex> lock(s.mutex);
+					s.wake.wait(lock, [&] { return !s.queue.empty(); });
+					task = std::move(s.queue.front());
+					s.queue.pop_front();
+					++s.active;
+				}
+				task();
+				{
+					std::lock_guard<std::mutex> lock(s.mutex);
+					--s.active;
+					++s.completed;
+					if (s.drainWaiters && s.completed >= s.drainTarget) s.idle.notify_all();
+				}
+			}
+		}
+
+		// run `task` after every task queued before it; synchronously when disabled or already on the worker
+		inline void run(std::function<void()> task) {
+			auto& s = state();
+			if (!s.enabled || onWorker()) {
+				task();
+				return;
+			}
+			bool needsWake;
+			{
+				std::lock_guard<std::mutex> lock(s.mutex);
+				if (!s.started) {
+					s.started = true;
+					std::thread thread(loop);
+					thread.detach();
+				}
+				// An active worker checks the queue before sleeping again. Only
+				// the idle/empty transition needs a wake; test under the same
+				// mutex as the worker's wait to avoid losing that transition.
+				needsWake = s.active == 0 && s.queue.empty();
+				s.queue.push_back(std::move(task));
+				++s.posted;
+			}
+			if (needsWake) s.wake.notify_one();
+		}
+
+		// start the worker now (called when the device is created): a thread created lazily later would inherit the
+		// affinity of whichever thread happened to create it (the game's main thread is pinned to its own core)
+		inline void ensureStarted() {
+			auto& s = state();
+			std::lock_guard<std::mutex> lock(s.mutex);
+			if (!s.started) {
+				s.started = true;
+				std::thread thread(loop);
+				thread.detach();
+			}
+		}
+
+		// like run(), but always on the worker (deferred render encoding uses the same FIFO, regardless of the opt-in flag)
+		inline void post(std::function<void()> task) {
+			auto& s = state();
+			bool needsWake;
+			{
+				std::lock_guard<std::mutex> lock(s.mutex);
+				if (!s.started) {
+					s.started = true;
+					std::thread thread(loop);
+					thread.detach();
+				}
+				// An active worker checks the queue before sleeping again. Only
+				// the idle/empty transition needs a wake; test under the same
+				// mutex as the worker's wait to avoid losing that transition.
+				needsWake = s.active == 0 && s.queue.empty();
+				s.queue.push_back(std::move(task));
+				++s.posted;
+			}
+			if (needsWake) s.wake.notify_one();
+		}
+
+		// true while the worker has queued or running tasks
+		inline bool pending() {
+			auto& s = state();
+			std::lock_guard<std::mutex> lock(s.mutex);
+			return !s.queue.empty() || s.active != 0;
+		}
+
+		// block until every task queued so far has finished (no-op on the worker itself)
+		inline void drain(const char* site = "drain") {
+			auto& s = state();
+			if (onWorker()) return;
+			std::unique_lock<std::mutex> lock(s.mutex);
+			const uint64_t target = s.posted;
+			if (s.completed >= target) return;
+			++s.drainWaiters;
+			if (target < s.drainTarget) s.drainTarget = target;
+			// FIFO completion is sufficient: later producers must not extend this wait.
+			Waits::blockOn(site, s.idle, lock, [&] { return s.completed >= target; });
+			if (--s.drainWaiters == 0) s.drainTarget = std::numeric_limits<uint64_t>::max();
+		}
+	}
+}
