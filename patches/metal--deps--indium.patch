+VkCommandPool Indium::PrivateCommandQueue::acquireCommandPool(VkCommandBuffer& buffer) {
+	std::lock_guard<std::mutex> lock(_poolMutex);
+	if (!_availablePools.empty()) {
+		auto pool = _availablePools.back();
+		_availablePools.pop_back();
+		// The previous owner retains this exclusive lease through GPU completion.
+		// Reset without RELEASE_RESOURCES so RADV can reuse its recording storage.
+		if (DynamicVK::vkResetCommandPool(_privateDevice->device(), pool.pool, 0) != VK_SUCCESS) abort();
+		buffer = pool.buffer;
+		return pool.pool;
+	}
+	VkCommandPoolCreateInfo info {};
+	info.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
+	info.queueFamilyIndex = _privateDevice->graphicsQueueFamilyIndex() ? *_privateDevice->graphicsQueueFamilyIndex() : *_privateDevice->computeQueueFamilyIndex();
+	buffer = VK_NULL_HANDLE;
+	VkCommandPool pool = VK_NULL_HANDLE;
+	if (DynamicVK::vkCreateCommandPool(_privateDevice->device(), &info, nullptr, &pool) != VK_SUCCESS) abort();
+	return pool;
+}
+
+void Indium::PrivateCommandQueue::releaseCommandPool(VkCommandPool pool, VkCommandBuffer buffer) {
+	std::lock_guard<std::mutex> lock(_poolMutex);
+	_availablePools.push_back({pool, buffer});
+}
+
 std::shared_ptr<Indium::CommandBuffer> Indium::PrivateCommandQueue::commandBuffer() {
 	return std::make_shared<PrivateCommandBuffer>(shared_from_this());
 };
