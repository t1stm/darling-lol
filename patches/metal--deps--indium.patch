diff --git a/private-include/indium/counters.private.hpp b/private-include/indium/counters.private.hpp
new file mode 100644
index 0000000..bc9b948
--- /dev/null
+++ b/private-include/indium/counters.private.hpp
@@ -0,0 +1,44 @@
+#pragma once
+
+#include <cstdio>
+#include <map>
+#include <mutex>
+#include <string>
+#include <time.h>
+#include <unistd.h>
+
+namespace Indium {
+	// Diagnostic SPIR-V/binding dumps: checked once per process (an access() per draw is a syscall plus path translation).
+	inline bool spirvDebugEnabled() {
+		static const bool enabled = access("/tmp/metal-debug-spirv", F_OK) == 0;
+		return enabled;
+	}
+
+	// Diagnostic event counters, written to the guest's /tmp/metal-trace.log every 5 s when /tmp/metal-debug-timing exists.
+	inline void count(const char* what, double amount = 1) {
+		static const bool enabled = access("/tmp/metal-debug-timing", F_OK) == 0;
+		if (!enabled) {
+			return;
+		}
+		static std::mutex lock;
+		static std::map<std::string, std::pair<unsigned long, double>> counts;
+		static time_t last = 0;
+		std::lock_guard<std::mutex> guard(lock);
+		auto& entry = counts[what];
+		entry.first++;
+		entry.second += amount;
+		time_t now = time(nullptr);
+		if (now - last >= 5) {
+			last = now;
+			if (FILE* log = fopen("/tmp/metal-trace.log", "a")) {
+				fprintf(log, "indium-counts@%ld:", (long) now);
+				for (auto& item: counts) {
+					fprintf(log, " %s[n=%lu sum=%.0f]", item.first.c_str(), item.second.first, item.second.second);
+				}
+				fprintf(log, "\n");
+				fclose(log);
+			}
+			counts.clear();
+		}
+	}
+};
