diff --git a/private-include/indium/render-pass-key.private.hpp b/private-include/indium/render-pass-key.private.hpp
new file mode 100644
index 0000000..c988f01
--- /dev/null
+++ b/private-include/indium/render-pass-key.private.hpp
@@ -0,0 +1,56 @@
+#pragma once
+#include <vulkan/vulkan.h>
+#include <array>
+#include <algorithm>
+#include <optional>
+
+namespace Indium {
+// Exact descriptions, rather than Vulkan compatibility, determine reuse: load
+// actions and layouts affect preservation of the game's attachment contents.
+struct RenderPassKey {
+    std::array<uint32_t, 256> words {};
+    size_t size = 0;
+    bool operator==(const RenderPassKey& other) const {
+        return size == other.size && std::equal(words.begin(), words.begin() + size, other.words.begin());
+    }
+    struct Hash {
+        size_t operator()(const RenderPassKey& key) const {
+            size_t result = 14695981039346656037ull;
+            for (size_t i = 0; i < key.size; ++i) result = (result ^ key.words[i]) * 1099511628211ull;
+            return result;
+        }
+    };
+};
+inline std::optional<RenderPassKey> renderPassKey(const VkRenderPassCreateInfo& info) {
+    // The encoder emits one subpass without input/resolve/preserve attachments.
+    // Unsupported structures retain the original uncached Vulkan path.
+    if (info.pNext || info.subpassCount != 1 || info.attachmentCount > 16 || info.dependencyCount > 2)
+        return std::nullopt;
+    const auto& subpass = info.pSubpasses[0];
+    if (subpass.inputAttachmentCount || subpass.pResolveAttachments || subpass.preserveAttachmentCount || subpass.colorAttachmentCount > 16)
+        return std::nullopt;
+    RenderPassKey key;
+    auto add = [&](uint32_t word) { key.words[key.size++] = word; };
+    add(info.flags); add(info.attachmentCount);
+    for (uint32_t i = 0; i < info.attachmentCount; ++i) {
+        const auto& a = info.pAttachments[i];
+        add(a.flags); add(a.format); add(a.samples); add(a.loadOp); add(a.storeOp);
+        add(a.stencilLoadOp); add(a.stencilStoreOp); add(a.initialLayout); add(a.finalLayout);
+    }
+    add(subpass.flags); add(subpass.pipelineBindPoint); add(subpass.colorAttachmentCount);
+    for (uint32_t i = 0; i < subpass.colorAttachmentCount; ++i) {
+        add(subpass.pColorAttachments[i].attachment); add(subpass.pColorAttachments[i].layout);
+    }
+    add(subpass.pDepthStencilAttachment != nullptr);
+    if (subpass.pDepthStencilAttachment) {
+        add(subpass.pDepthStencilAttachment->attachment); add(subpass.pDepthStencilAttachment->layout);
+    }
+    add(info.dependencyCount);
+    for (uint32_t i = 0; i < info.dependencyCount; ++i) {
+        const auto& d = info.pDependencies[i];
+        add(d.srcSubpass); add(d.dstSubpass); add(d.srcStageMask); add(d.dstStageMask);
+        add(d.srcAccessMask); add(d.dstAccessMask); add(d.dependencyFlags);
+    }
+    return key;
+}
+}
