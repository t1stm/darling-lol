+// The Vulkan spec orders memory types so that a type whose flags are a subset of
+// another's comes first. A flag-less type (system RAM the GPU reads over PCIe,
+// which NVIDIA exposes) therefore precedes every DEVICE_LOCAL type, and the first
+// type allowed by memoryTypeBits put resources only the GPU touches in system RAM
+// there. Private and Memoryless resources now take the first allowed DEVICE_LOCAL
+// type and fall back to that first fit. Shared and Managed keep the first fit
+// that is host visible (and coherent for Shared): moving them to DEVICE_LOCAL and
+// HOST_VISIBLE BAR memory would make their CPU reads uncached. On RADV type 0 is
+// DEVICE_LOCAL, so nothing changes there.
+size_t Indium::PrivateDevice::findMemoryType(uint32_t memoryTypeBits, StorageMode storageMode, bool image) {
+	const auto& memory = _memoryProperties;
+	const bool gpuOnly = storageMode == StorageMode::Private || storageMode == StorageMode::Memoryless;
+	size_t firstFit = SIZE_MAX;
+	size_t deviceLocal = SIZE_MAX;
+
+	for (size_t i = 0; i < memory.memoryTypeCount; ++i) {
+		const auto& type = memory.memoryTypes[i];
+
+		if ((memoryTypeBits & (1u << i)) == 0) {
+			continue;
+		}
+
+		if ((storageMode == StorageMode::Managed || storageMode == StorageMode::Shared) && (type.propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) == 0) {
+			continue;
+		}
+
+		if (storageMode == StorageMode::Shared && (type.propertyFlags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) == 0) {
+			continue;
+		}
+
+		if (firstFit == SIZE_MAX) {
+			firstFit = i;
+		}
+
+		if (!gpuOnly || (type.propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) != 0) {
+			deviceLocal = i;
+			break;
+		}
+	}
+
+	const size_t chosen = deviceLocal != SIZE_MAX ? deviceLocal : firstFit;
+	if (chosen == SIZE_MAX) {
+		return chosen;
+	}
+
+	// Logged the first time each (kind, storage mode, type) occurs in the process;
+	// afterwards this is one relaxed load. 2 kinds x 4 modes x 32 types = 256 bits.
+	static std::atomic<uint64_t> logged[4] {};
+	const size_t bit = ((image ? 4u : 0u) + (static_cast<size_t>(storageMode) & 3)) * 32 + chosen;
+	const uint64_t mask = uint64_t(1) << (bit & 63);
+	if ((logged[bit >> 6].load(std::memory_order_relaxed) & mask) == 0 && (logged[bit >> 6].fetch_or(mask) & mask) == 0) {
+		static const char* modeNames[] = { "shared", "managed", "private", "memoryless" };
+		auto describe = [&](size_t index) {
+			const auto& type = memory.memoryTypes[index];
+			return std::to_string(index) + " flags=" + memoryFlagsString(type.propertyFlags)
+				+ " heap=" + std::to_string(type.heapIndex)
+				+ " heapDeviceLocal=" + ((memory.memoryHeaps[type.heapIndex].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) ? "yes" : "no");
+		};
+		appendDeviceLog(std::string("memory alloc kind=") + (image ? "texture" : "buffer")
+			+ " storage=" + modeNames[static_cast<size_t>(storageMode) & 3]
+			+ " typeBits=0x" + hexValue(memoryTypeBits, 8)
+			+ " type=" + describe(chosen)
+			+ " firstFit=" + describe(firstFit)
+			+ (chosen != firstFit ? " changed=yes" : " changed=no"));
+	}
+
+	return chosen;
+};
