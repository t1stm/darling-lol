diff --git a/private-include/indium/gpu-timing.private.hpp b/private-include/indium/gpu-timing.private.hpp
new file mode 100644
index 0000000..ae560ab
--- /dev/null
+++ b/private-include/indium/gpu-timing.private.hpp
@@ -0,0 +1,259 @@
+#pragma once
+
+// Diagnostic GPU profiler built on Vulkan timestamp queries (guest flag files, checked once at start):
+//   /tmp/metal-gpu-timing         per render pass: start/end on the GPU timeline -> /tmp/indium-gpu-timing.log
+//                                 line per command buffer: "cb <WxH>:<draws>:<ms>:<start_ns> ..."
+//   /tmp/metal-gpu-timing-draws   additionally a timestamp after every draw; GPU time is attributed to the pipeline
+//                                 state (vertex+fragment function names in /tmp/indium-gpu-pso.log) and summed per
+//                                 (pso, target size) into /tmp/indium-gpu-draws.log (rewritten every 5 s)
+// Header-only, function-local statics: no class gains a member (QuartzCore/Metal read Indium objects at fixed offsets).
+
+#include <indium/dynamic-vk.hpp>
+
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <map>
+#include <mutex>
+#include <string>
+#include <tuple>
+#include <unordered_map>
+#include <vector>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+namespace Indium {
+	namespace GpuTiming {
+		struct Pass {
+			uint32_t first;
+			uint32_t width;
+			uint32_t height;
+			uint32_t draws;
+			std::vector<uint64_t> drawPso; // pso id per draw timestamp, in order
+		};
+
+		struct State {
+			static constexpr uint32_t Capacity = 1u << 20; // 8 MB: ~1700 passes of in-flight history, no wrap hazard
+			static constexpr uint32_t DrawSlots = 600;
+			std::mutex mutex;
+			VkQueryPool pool = VK_NULL_HANDLE;
+			uint32_t next = 0;
+			std::unordered_map<VkCommandBuffer, std::vector<Pass>> passes;
+			std::map<std::tuple<uint64_t, uint32_t, uint32_t>, std::pair<double, uint64_t>> perPso; // ms, draws
+			std::map<std::tuple<uint64_t, uint32_t, uint32_t>, std::pair<double, uint64_t>> perPsoSingle; // passes with one draw
+			std::chrono::steady_clock::time_point lastDump = std::chrono::steady_clock::now();
+			FILE* log = nullptr;
+			bool enabled = access("/tmp/metal-gpu-timing", F_OK) == 0;
+			bool drawLevel = access("/tmp/metal-gpu-timing-draws", F_OK) == 0;
+		};
+
+		inline State& state() {
+			static State* instance = new State;
+			return *instance;
+		}
+
+		inline bool enabled() { return state().enabled; }
+
+		inline thread_local uint32_t currentDraws = 0;
+
+		inline void countDraw() {
+			if (state().enabled) ++currentDraws;
+		}
+
+		// SPIR-V library identity: FNV-1a over the module, and (draw-level mode) the module saved as <hash>.spv
+		inline std::unordered_map<const void*, std::string>& libraryIds() {
+			static auto* ids = new std::unordered_map<const void*, std::string>;
+			return *ids;
+		}
+
+		inline void noteLibrary(const void* library, const char* data, size_t length) {
+			auto& s = state();
+			if (!s.enabled || !s.drawLevel) return;
+			uint64_t h = 1469598103934665603ull;
+			for (size_t i = 0; i < length; ++i) { h ^= (unsigned char) data[i]; h *= 1099511628211ull; }
+			char id[48];
+			snprintf(id, sizeof(id), "%08llx:%zu", (unsigned long long) (h & 0xffffffffull), length);
+			{
+				std::lock_guard<std::mutex> lock(s.mutex);
+				libraryIds()[library] = id;
+			}
+			char path[96];
+			snprintf(path, sizeof(path), "/tmp/indium-shaders/%08llx.spv", (unsigned long long) (h & 0xffffffffull));
+			mkdir("/tmp/indium-shaders", 0755);
+			if (access(path, F_OK) != 0) {
+				if (FILE* f = fopen(path, "wb")) { fwrite(data, 1, length, f); fclose(f); }
+			}
+		}
+
+		inline std::string libraryId(const void* library) {
+			auto& s = state();
+			std::lock_guard<std::mutex> lock(s.mutex);
+			auto it = libraryIds().find(library);
+			return it == libraryIds().end() ? std::string("-") : it->second;
+		}
+
+		inline void notePipeline(const void* pso, const std::string& vertex, const std::string& fragment) {
+			auto& s = state();
+			if (!s.enabled || !s.drawLevel) return;
+			if (FILE* f = fopen("/tmp/indium-gpu-pso.log", "a")) {
+				fprintf(f, "%llx %s %s\n", (unsigned long long) (uintptr_t) pso, vertex.c_str(), fragment.c_str());
+				fclose(f);
+			}
+		}
+
+		// before vkCmdBeginRenderPass (outside any render pass)
+		inline void beginPass(VkDevice device, VkCommandBuffer cb, uint32_t width, uint32_t height) {
+			auto& s = state();
+			if (!s.enabled) return;
+			std::lock_guard<std::mutex> lock(s.mutex);
+			if (s.pool == VK_NULL_HANDLE) {
+				VkQueryPoolCreateInfo info {};
+				info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+				info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+				info.queryCount = State::Capacity;
+				if (DynamicVK::vkCreateQueryPool(device, &info, nullptr, &s.pool) != VK_SUCCESS) {
+					s.enabled = false;
+					return;
+				}
+			}
+			uint32_t block = 2 + (s.drawLevel ? State::DrawSlots : 0);
+			if (s.next + block > State::Capacity) s.next = 0;
+			uint32_t first = s.next;
+			s.next += block;
+			DynamicVK::vkCmdResetQueryPool(cb, s.pool, first, block);
+			DynamicVK::vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, s.pool, first);
+			s.passes[cb].push_back(Pass { first, width, height, 0, {} });
+			currentDraws = 0;
+		}
+
+		// render target configuration of every pass: "<WxH> c<n>=<format>/<load>/<store>... d=<format>/<load>/<store>" -> count,
+		// rewritten to /tmp/indium-gpu-targets.log every 5 s (pixel format/action numbers are Indium enum values)
+		inline void noteTarget(const std::string& key) {
+			auto& s = state();
+			if (!s.enabled) return;
+			static auto* counts = new std::map<std::string, uint64_t>;
+			static auto last = std::chrono::steady_clock::now();
+			std::lock_guard<std::mutex> lock(s.mutex);
+			++(*counts)[key];
+			auto now = std::chrono::steady_clock::now();
+			if (now - last < std::chrono::seconds(5)) return;
+			last = now;
+			if (FILE* f = fopen("/tmp/indium-gpu-targets.log", "w")) {
+				for (const auto& [k, v] : *counts) fprintf(f, "%llu %s\n", (unsigned long long) v, k.c_str());
+				fclose(f);
+			}
+		}
+
+		// whole command buffer: logged like a pass with size 3x3 (first pass of the command buffer, end written at commit)
+		inline void beginSpan(VkDevice device, VkCommandBuffer cb) { beginPass(device, cb, 3, 3); }
+
+		inline void endSpan(VkCommandBuffer cb) {
+			auto& s = state();
+			if (!s.enabled) return;
+			std::lock_guard<std::mutex> lock(s.mutex);
+			auto it = s.passes.find(cb);
+			if (it == s.passes.end() || it->second.empty() || it->second.front().width != 3) return;
+			DynamicVK::vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, s.pool, it->second.front().first + 1);
+		}
+
+		// after each vkCmdDraw / vkCmdDrawIndexed
+		inline void afterDraw(VkCommandBuffer cb, uint64_t pso) {
+			auto& s = state();
+			if (!s.enabled || !s.drawLevel) return;
+			std::lock_guard<std::mutex> lock(s.mutex);
+			auto it = s.passes.find(cb);
+			if (it == s.passes.end() || it->second.empty()) return;
+			auto& pass = it->second.back();
+			if (pass.drawPso.size() >= State::DrawSlots - 1) return;
+			DynamicVK::vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, s.pool, pass.first + 2 + (uint32_t) pass.drawPso.size());
+			pass.drawPso.push_back(pso);
+		}
+
+		// after vkCmdEndRenderPass
+		inline void endPass(VkCommandBuffer cb) {
+			auto& s = state();
+			if (!s.enabled) return;
+			std::lock_guard<std::mutex> lock(s.mutex);
+			auto it = s.passes.find(cb);
+			if (it == s.passes.end() || it->second.empty()) return;
+			auto& pass = it->second.back();
+			pass.draws = currentDraws;
+			DynamicVK::vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, s.pool, pass.first + 1);
+		}
+
+		inline void dumpDraws(State& s) {
+			if (!s.drawLevel) return;
+			auto now = std::chrono::steady_clock::now();
+			if (now - s.lastDump < std::chrono::seconds(5)) return;
+			s.lastDump = now;
+			if (FILE* f = fopen("/tmp/indium-gpu-draws.log", "w")) {
+				for (const auto& [key, v] : s.perPso)
+					fprintf(f, "%llx %ux%u %llu %.4f\n", (unsigned long long) std::get<0>(key), std::get<1>(key), std::get<2>(key),
+						(unsigned long long) v.second, v.first);
+				fclose(f);
+			}
+			if (FILE* f = fopen("/tmp/indium-gpu-single.log", "w")) {
+				for (const auto& [key, v] : s.perPsoSingle)
+					fprintf(f, "%llx %ux%u %llu %.4f\n", (unsigned long long) std::get<0>(key), std::get<1>(key), std::get<2>(key),
+						(unsigned long long) v.second, v.first);
+				fclose(f);
+			}
+		}
+
+		// when the command buffer has completed on the GPU
+		inline void collect(VkDevice device, VkCommandBuffer cb, double periodNs) {
+			auto& s = state();
+			if (!s.enabled) return;
+			std::vector<Pass> passes;
+			{
+				std::lock_guard<std::mutex> lock(s.mutex);
+				auto it = s.passes.find(cb);
+				if (it == s.passes.end()) return;
+				passes = std::move(it->second);
+				s.passes.erase(it);
+			}
+			if (passes.empty()) return;
+			std::string line;
+			char buf[96];
+			std::vector<uint64_t> t;
+			std::vector<std::tuple<uint64_t, uint32_t, uint32_t, double>> samples; // pso, w, h, ms
+			std::vector<std::tuple<uint64_t, uint32_t, uint32_t, double>> singles;
+			for (const auto& pass : passes) {
+				uint32_t n = 2 + (uint32_t) pass.drawPso.size();
+				t.assign(n, 0);
+				// the mutex is NOT held while waiting for the GPU: the render thread takes it for every pass and draw
+				if (DynamicVK::vkGetQueryPoolResults(device, s.pool, pass.first, n, n * sizeof(uint64_t), t.data(), sizeof(uint64_t),
+						VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT) != VK_SUCCESS) continue;
+				snprintf(buf, sizeof(buf), " %ux%u:%u:%.3f:%.0f", pass.width, pass.height, pass.draws,
+					(double) (t[1] - t[0]) * periodNs / 1e6, (double) t[0] * periodNs);
+				line += buf;
+				uint64_t previous = t[0];
+				for (size_t i = 0; i < pass.drawPso.size(); ++i) {
+					uint64_t now = t[2 + i];
+					double ms = now > previous ? (double) (now - previous) * periodNs / 1e6 : 0;
+					previous = now > previous ? now : previous;
+					samples.emplace_back(pass.drawPso[i], pass.width, pass.height, ms);
+					if (pass.drawPso.size() == 1) singles.emplace_back(pass.drawPso[i], pass.width, pass.height, (double) (t[1] - t[0]) * periodNs / 1e6);
+				}
+			}
+			std::lock_guard<std::mutex> lock(s.mutex);
+			for (const auto& [pso, w, h, ms] : samples) {
+				auto& entry = s.perPso[std::make_tuple(pso, w, h)];
+				entry.first += ms;
+				entry.second += 1;
+			}
+			for (const auto& [pso, w, h, ms] : singles) {
+				auto& entry = s.perPsoSingle[std::make_tuple(pso, w, h)];
+				entry.first += ms;
+				entry.second += 1;
+			}
+			if (!s.log) s.log = fopen("/tmp/indium-gpu-timing.log", "a");
+			if (s.log) {
+				fprintf(s.log, "cb%s\n", line.c_str());
+				fflush(s.log);
+			}
+			dumpDraws(s);
+		}
+	}
+}
