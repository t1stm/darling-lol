+static bool seqLogActive() {
+	static unsigned calls = 0;
+	static bool active = false;
+	if ((calls++ & 255) == 0) active = access("/tmp/metal-seqlog", F_OK) == 0;
+	return active;
+}
+static void seqLog(const char* fmt, ...) __attribute__((format(printf, 1, 2)));
+static void seqLog(const char* fmt, ...) {
+	static FILE* file = fopen("/tmp/indium-gpu-seq.log", "a");
+	if (!file || !seqLogActive()) return;
+	va_list args;
+	va_start(args, fmt);
+	vfprintf(file, fmt, args);
+	va_end(args);
+	fflush(file);
+}
+static void seqLogBytes(const char* stage, const void* bytes, size_t length, size_t index) {
+	if (length > 96 || !bytes) return;
+	char buf[512];
+	int n = snprintf(buf, sizeof(buf), "  %s%zu len=%zu f=", stage, index, length);
+	const float* f = static_cast<const float*>(bytes);
+	for (size_t i = 0; i + 4 <= length && n < 480; i += 4) n += snprintf(buf + n, sizeof(buf) - n, "%.3g ", f[i / 4]);
+	seqLog("%s\n", buf);
+}
