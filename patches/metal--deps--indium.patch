diff --git a/private-include/indium/completion-spin.private.hpp b/private-include/indium/completion-spin.private.hpp
new file mode 100644
index 0000000..962fdad
--- /dev/null
+++ b/private-include/indium/completion-spin.private.hpp
@@ -0,0 +1,18 @@
+#pragma once
+#include <cstdint>
+
+namespace Indium {
+// A malformed override uses the vendor default. Saturation bounds both CPU use
+// and the microseconds-to-nanoseconds conversion, even for arbitrarily long input.
+inline uint64_t completionSpinBudget(uint32_t vendorID, const char* overrideValue) {
+    const uint64_t fallback = vendorID == 0x10de ? 2000000 : 0;
+    if (!overrideValue || !*overrideValue) return fallback;
+    uint64_t microseconds = 0;
+    for (const char* p = overrideValue; *p; ++p) {
+        if (*p < '0' || *p > '9') return fallback;
+        microseconds = microseconds * 10 + (*p - '0');
+        if (microseconds > 10000) microseconds = 10000;
+    }
+    return microseconds * 1000;
+}
+}
