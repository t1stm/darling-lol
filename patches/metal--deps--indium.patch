+// AIR links varyings by their user location, not by their order in each stage.
+// Optimized fragment functions may omit entries that the vertex stage still writes.
+static uint32_t airInterfaceLocation(const std::vector<LLVMValueRef>& metadata, uint32_t fallback) {
+    for (size_t i = 0; i < metadata.size(); ++i) {
+        if (!DynamicLLVM::LLVMIsAMDString(metadata[i])) continue;
+        unsigned length = 0;
+        const char* bytes = DynamicLLVM::LLVMGetMDString(metadata[i], &length);
+        std::string_view value(bytes, length);
+        constexpr std::string_view prefix = "user(locn";
+        if (value.size() > prefix.size() + 1 && value.substr(0, prefix.size()) == prefix && value.back() == ')') {
+            uint32_t location = 0;
+            for (char digit : value.substr(prefix.size(), value.size() - prefix.size() - 1)) {
+                if (digit < '0' || digit > '9') throw std::runtime_error("Invalid AIR varying location");
+                location = location * 10 + static_cast<uint32_t>(digit - '0');
+            }
+            return location;
+        }
+        if (value == "air.render_target" && i + 1 < metadata.size())
+            return static_cast<uint32_t>(DynamicLLVM::LLVMConstIntGetZExtValue(metadata[i + 1]));
+    }
+    return fallback;
+}
