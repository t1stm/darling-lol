diff --git a/private-include/indium/resource-owner-cache.private.hpp b/private-include/indium/resource-owner-cache.private.hpp
new file mode 100644
index 0000000..74ccc6e
--- /dev/null
+++ b/private-include/indium/resource-owner-cache.private.hpp
@@ -0,0 +1,62 @@
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <utility>
+#include <vector>
+
+namespace Indium {
+    // Encoder-local, insert-only cache. Contiguous owners avoid allocating and
+    // freeing a hash node for every resource. Owners are never erased while
+    // recorded GPU commands can reference them, so pointer identities stay valid.
+    template<class Base, class Private> class ResourceOwnerCache {
+    public:
+        struct Entry {
+            std::shared_ptr<Base> owner;
+            Private* value = nullptr;
+            bool depthFeedback = false;
+        };
+    private:
+        std::vector<Entry> _owners;
+        std::vector<size_t> _buckets; // owner index + 1; zero is an empty bucket
+
+        static size_t hash(Base* object) {
+            uint64_t value = reinterpret_cast<uintptr_t>(object);
+            value ^= value >> 30;
+            value *= UINT64_C(0xbf58476d1ce4e5b9);
+            value ^= value >> 27;
+            return static_cast<size_t>(value);
+        }
+        void grow() {
+            std::vector<size_t> buckets(_buckets.empty() ? 16 : _buckets.size() * 2, 0);
+            for (size_t i = 0; i < _owners.size(); ++i) {
+                size_t slot = hash(_owners[i].owner.get()) & (buckets.size() - 1);
+                while (buckets[slot]) slot = (slot + 1) & (buckets.size() - 1);
+                buckets[slot] = i + 1;
+            }
+            _buckets.swap(buckets);
+        }
+    public:
+        size_t size() const { return _owners.size(); }
+        // Returned pointers are valid until the next insertion, like vector
+        // elements. Callers copy the resolved pointer into their binding slot.
+        std::pair<Entry*, bool> acquire(const std::shared_ptr<Base>& owner) {
+            if (!owner) return {nullptr, false};
+            if (_buckets.empty()) grow();
+            size_t slot = hash(owner.get()) & (_buckets.size() - 1);
+            while (_buckets[slot]) {
+                auto& entry = _owners[_buckets[slot] - 1];
+                if (entry.owner.get() == owner.get()) return {&entry, false};
+                slot = (slot + 1) & (_buckets.size() - 1);
+            }
+            if ((_owners.size() + 1) * 2 > _buckets.size()) {
+                grow();
+                slot = hash(owner.get()) & (_buckets.size() - 1);
+                while (_buckets[slot]) slot = (slot + 1) & (_buckets.size() - 1);
+            }
+            _owners.push_back(Entry{owner, dynamic_cast<Private*>(owner.get()), false});
+            _buckets[slot] = _owners.size();
+            return {&_owners.back(), true};
+        }
+    };
+}
