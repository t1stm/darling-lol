+				} catch (const std::exception& e) {
+					st.failed = true;
+					if (FILE* f = fopen("/tmp/metal-trace.log", "a")) { fprintf(f, "async-blit: encoder creation failed: %s\n", e.what()); fclose(f); }
+				}
