+
+namespace Indium {
+    // Completed GPU work only. A full queue falls back to synchronous cleanup,
+    // bounding retained resources even if the worker cannot keep up.
+    template<class Job, size_t capacity = 32> class RetirementQueue {
+        std::array<std::optional<Job>, capacity> _jobs;
+        size_t _head = 0, _count = 0;
+        bool _stopping = false;
+        std::mutex _mutex;
+        std::condition_variable _ready;
+        std::thread _worker;
+
+        void run() {
+            for (;;) {
+                std::optional<Job> job;
+                {
+                    std::unique_lock<std::mutex> lock(_mutex);
+                    _ready.wait(lock, [&] { return _count || _stopping; });
+                    if (!_count && _stopping) return;
+                    job = std::move(_jobs[_head]);
+                    _jobs[_head].reset();
+                    _head = (_head + 1) % capacity;
+                    --_count;
+                }
+                // Resource destructors and driver calls never hold the queue lock.
+                (*job)();
+            }
+        }
+    public:
+        RetirementQueue() : _worker([this] { run(); }) {}
+        RetirementQueue(const RetirementQueue&) = delete;
+        ~RetirementQueue() { shutdown(); }
+
+        bool tryPush(Job&& job) {
+            {
+                std::lock_guard<std::mutex> lock(_mutex);
+                if (_stopping || _count == capacity) return false;
+                _jobs[(_head + _count) % capacity].emplace(std::move(job));
+                ++_count;
+            }
+            _ready.notify_one();
+            return true;
+        }
+        // Called before Vulkan/device teardown, while all driver entry points
+        // remain valid. Drain queued jobs before joining the worker.
+        void shutdown() {
+            {
+                std::lock_guard<std::mutex> lock(_mutex);
+                _stopping = true;
+            }
+            _ready.notify_one();
+            if (_worker.joinable()) _worker.join();
+        }
+    };
+}
diff --git a/private-include/indium/submission-batch.private.hpp b/private-include/indium/submission-batch.private.hpp
new file mode 100644
index 0000000..06054c4
--- /dev/null
+++ b/private-include/indium/submission-batch.private.hpp
@@ -0,0 +1,54 @@
+#pragma once
+#include <vulkan/vulkan.h>
+#include <array>
+#include <cassert>
+#include <vector>
+
+namespace Indium {
+    // Protected by the device graphics-queue mutex. Each packet preserves the
+    // original submit boundary and its semaphore waits/signals. Only the host
+    // driver call is combined; commands are not reordered or merged.
+    class SubmissionBatch {
+        static constexpr size_t capacity = 128;
+        struct Packet {
+            VkSubmitFlags flags = 0;
+            VkCommandBufferSubmitInfo command {};
+            std::vector<VkSemaphoreSubmitInfo> waits, signals;
+        };
+        std::array<Packet, capacity> _packets;
+        size_t _count = 0;
+    public:
+        bool empty() const { return _count == 0; }
+        bool full() const { return _count == capacity; }
+        void append(const VkSubmitInfo2& info) {
+            assert(!full() && !info.pNext && info.commandBufferInfoCount == 1);
+            auto& packet = _packets[_count++];
+            packet.flags = info.flags;
+            packet.command = info.pCommandBufferInfos[0];
+            packet.waits.clear(); packet.signals.clear();
+            if (info.waitSemaphoreInfoCount)
+                packet.waits.assign(info.pWaitSemaphoreInfos, info.pWaitSemaphoreInfos + info.waitSemaphoreInfoCount);
+            if (info.signalSemaphoreInfoCount)
+                packet.signals.assign(info.pSignalSemaphoreInfos, info.pSignalSemaphoreInfos + info.signalSemaphoreInfoCount);
+        }
+        template<class Submit> VkResult flush(Submit&& submit) {
+            if (empty()) return VK_SUCCESS;
+            std::array<VkSubmitInfo2, capacity> infos {};
+            for (size_t i = 0; i < _count; ++i) {
+                const auto& packet = _packets[i];
+                auto& info = infos[i];
+                info.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO_2;
+                info.flags = packet.flags;
+                info.commandBufferInfoCount = 1;
+                info.pCommandBufferInfos = &packet.command;
+                info.waitSemaphoreInfoCount = packet.waits.size();
+                info.pWaitSemaphoreInfos = packet.waits.data();
+                info.signalSemaphoreInfoCount = packet.signals.size();
+                info.pSignalSemaphoreInfos = packet.signals.data();
+            }
+            VkResult result = submit(static_cast<uint32_t>(_count), infos.data());
+            if (result == VK_SUCCESS) _count = 0;
+            return result;
+        }
+    };
+}
