diff --git a/private-include/indium/waits.private.hpp b/private-include/indium/waits.private.hpp
new file mode 100644
index 0000000..4e27d4c
--- /dev/null
+++ b/private-include/indium/waits.private.hpp
@@ -0,0 +1,145 @@
+#pragma once
+
+// Wait-site counters.
+//
+// The main thread's frame budget is spent partly on blocking in our own hand-offs (the submit worker's drain, the
+// deferred-encoder sync, texture uploads) and in the compositor's drawable hand-out. A sample profile cannot attribute
+// that time (the blocked PC is inside a futex helper), so every wait site counts how often the calling thread *actually
+// blocked* and how long, and appends a summary to the guest's /tmp/metal-trace.log every 5 s.
+//
+// Everything here is always compiled in; the counters are only active when /tmp/metal-debug-waits exists when the
+// process starts (checked once). Disabled, each site costs one predictable branch: a call site must establish that it
+// is about to block (a false predicate under the lock, a free-drawable check) before it constructs a Block, and that
+// check is the only work done when the flag is absent.
+//
+// Header-only: the counter state is per dylib (each library writes its own summary), so no class gains a member. The
+// functions are declared hidden: an inline function's static locals are otherwise exported as weak definitions (even
+// under -fvisibility-inlines-hidden), and dyld coalesces those across images, so libindium and QuartzCore would share
+// one copy -- harmless only while both images were built from the same version of this header. Hidden keeps the state
+// in each image, as documented.
+//
+// Flag file pitfall (why a match can show no waits lines although the file "exists"): the guest /tmp is
+// ~/.darling/private/tmp *inside Darling's overlay mount*, i.e. the host path is the overlay's upper directory. A file
+// created there from the host while the Darling namespace is running is not guaranteed to be visible to guest
+// processes: once a guest process has looked the name up and got ENOENT, the overlay caches the negative entry and
+// keeps answering ENOENT. Create flag files from inside the guest (`darling shell touch /tmp/metal-debug-waits`) or
+// while Darling is shut down. When the counters are on, the first check writes a "waits enabled" line, so its absence
+// from /tmp/metal-trace.log means the flag was not seen.
+
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <map>
+#include <mutex>
+#include <string>
+#include <dlfcn.h>
+#include <time.h>
+#include <unistd.h>
+
+#define INDIUM_WAITS_LOCAL __attribute__((visibility("hidden")))
+
+namespace Indium {
+	namespace Waits {
+		// The summaries append to the guest's /tmp/metal-trace.log like the other diagnostics; DARLING_WAITS_LOG
+		// overrides the path so the host-side test does not append to the runtime's log. Only read when the counters
+		// are on (i.e. from the dump path).
+		INDIUM_WAITS_LOCAL inline const char* logPath() {
+			static const char* path = []() -> const char* {
+				const char* override = getenv("DARLING_WAITS_LOG");
+				return override && *override ? override : "/tmp/metal-trace.log";
+			}();
+			return path;
+		}
+
+		// Guest flag file, read once per process (per image) at the first wait site that is reached. When it is on, that
+		// first check appends one "waits enabled" line naming the image, so a match log proves the path is live even if
+		// no site ever blocks.
+		INDIUM_WAITS_LOCAL inline bool readEnabled() {
+			if (access("/tmp/metal-debug-waits", F_OK) != 0) return false;
+			Dl_info info {};
+			const char* image = dladdr(reinterpret_cast<void*>(&readEnabled), &info) && info.dli_fname ? info.dli_fname : "?";
+			if (FILE* log = fopen(logPath(), "a")) {
+				fprintf(log, "waits enabled@%ld: pid=%d image=%s\n", (long) time(nullptr), (int) getpid(), image);
+				fclose(log);
+			}
+			return true;
+		}
+
+		INDIUM_WAITS_LOCAL inline bool enabled() {
+			static const bool value = readEnabled();
+			return value;
+		}
+
+		// Monotonic nanoseconds. steady_clock is what the rest of Indium uses (libc++ maps it to CLOCK_UPTIME_RAW, i.e.
+		// mach_absolute_time, on Darwin); clock_gettime(CLOCK_MONOTONIC) is wall-clock-derived in Darwin's libc
+		// (gettimeofday minus the boot time, with a kern.boottime sysctl fallback), so it is neither monotonic nor cheap
+		// under Darling.
+		INDIUM_WAITS_LOCAL inline uint64_t now() {
+			return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+				std::chrono::steady_clock::now().time_since_epoch()).count());
+		}
+
+		INDIUM_WAITS_LOCAL inline void record(const char* site, uint64_t nanoseconds) {
+			struct Stat { uint64_t blocks = 0, sum = 0, max = 0; };
+			static std::mutex lock;
+			static std::map<std::string, Stat> stats;
+			static time_t last = 0;
+			std::lock_guard<std::mutex> guard(lock);
+			Stat& stat = stats[site];
+			++stat.blocks;
+			stat.sum += nanoseconds;
+			if (nanoseconds > stat.max) stat.max = nanoseconds;
+			time_t now = time(nullptr);
+			if (now - last >= 5) {
+				last = now;
+				if (FILE* log = fopen(logPath(), "a")) {
+					fprintf(log, "waits@%ld:", (long) now);
+					for (auto& entry: stats) {
+						fprintf(log, " %s[n=%llu sum=%.1fus max=%.1fus]", entry.first.c_str(),
+							(unsigned long long) entry.second.blocks, entry.second.sum / 1000.0, entry.second.max / 1000.0);
+					}
+					fprintf(log, "\n");
+					fclose(log);
+				}
+				stats.clear();
+			}
+		}
+
+		// One blocking episode of `site`. The constructor checks the flag and the destructor records (a no-op when the
+		// counter is off). Use it around a wait that is known to block; blockOn()/blockOnLock() do that check for the
+		// sites where the caller cannot know in advance.
+		struct INDIUM_WAITS_LOCAL Block {
+			const char* site;
+			uint64_t start = 0;
+			explicit Block(const char* site_): site(site_) { if (enabled()) start = now(); }
+			~Block() { if (start != 0) record(site, now() - start); }
+		};
+
+		// Wait for `predicate` on `condvar`, counting the block only when the predicate is already false at the call
+		// (i.e. the wait really has to sleep). The predicate is re-checked by the wait itself, so both paths are safe.
+		template<class Predicate>
+		INDIUM_WAITS_LOCAL inline void blockOn(const char* site, std::condition_variable& condvar, std::unique_lock<std::mutex>& lock, Predicate predicate) {
+			if (!enabled() || predicate()) {
+				condvar.wait(lock, predicate);
+				return;
+			}
+			Block block(site);
+			condvar.wait(lock, predicate);
+		}
+
+		// Lock `mutex`, counting the block only when it is contended at the time of the call. try_lock only runs when
+		// the flag is on, so the disabled cost is the same single branch.
+		INDIUM_WAITS_LOCAL inline void blockOnLock(const char* site, std::mutex& mutex) {
+			if (!enabled()) {
+				mutex.lock();
+				return;
+			}
+			if (mutex.try_lock()) return;
+			Block block(site);
+			mutex.lock();
+		}
+	}
+}
