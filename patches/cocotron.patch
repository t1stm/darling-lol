+            else if (nid == 1 && !family) slot = &family;
+            else if (nid == 2 && !style) slot = &style;
+            else if (nid == 4 && !psName) slot = &psName;
+            else if (nid == 16 && !family) slot = &family;
+            else if (nid == 17 && !style) slot = &style;
