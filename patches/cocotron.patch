+    CTFontDescriptorRef result = NULL;
+    if (matches) {
+        if (CFArrayGetCount(matches))
+            result = (CTFontDescriptorRef)CFRetain(CFArrayGetValueAtIndex(matches, 0));
+        CFRelease(matches);
+    }
+    return result;
+}
