+- (void) _ensureTrayDocked {
+    if (_x11TrayWindow == 0) {
+        [self _createTrayIcon];
+        return;
+    }
+    if (_x11TrayDocked) return;
+
+    X11Display *d = (X11Display *) [NSDisplay currentDisplay];
+    Display *dpy = [d display];
+    if (dpy == NULL) return;
+
+    int screen = DefaultScreen(dpy);
+    char tray_atom_name[32];
+    snprintf(tray_atom_name, sizeof(tray_atom_name), "_NET_SYSTEM_TRAY_S%d", screen);
+    Atom tray_atom = XInternAtom(dpy, tray_atom_name, False);
+    Window tray_manager = XGetSelectionOwner(dpy, tray_atom);
+
+    if (tray_manager != None) {
+        XClientMessageEvent dock_ev;
+        memset(&dock_ev, 0, sizeof(dock_ev));
+        dock_ev.type = ClientMessage;
+        dock_ev.window = tray_manager;
+        dock_ev.message_type = XInternAtom(dpy, "_NET_SYSTEM_TRAY_OPCODE", False);
+        dock_ev.format = 32;
+        dock_ev.data.l[0] = CurrentTime;
+        dock_ev.data.l[1] = 0; // SYSTEM_TRAY_REQUEST_DOCK
+        dock_ev.data.l[2] = (Window) _x11TrayWindow;
+        dock_ev.data.l[3] = 0;
+        dock_ev.data.l[4] = 0;
+
+        XSendEvent(dpy, tray_manager, False, StructureNotifyMask, (XEvent *) &dock_ev);
+        XSendEvent(dpy, tray_manager, False, NoEventMask, (XEvent *) &dock_ev);
+        XMapRaised(dpy, (Window) _x11TrayWindow);
+        XSync(dpy, False);
+        _x11TrayDocked = YES;
+    }
