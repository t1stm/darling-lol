+static CFStringRef sfnt_copyName(const uint8_t *data, size_t len,
+                                 const uint8_t *storage, size_t storageLen,
+                                 uint16_t platform, uint16_t encoding,
+                                 uint16_t length, uint16_t offset) {
+    const uint8_t *s;
