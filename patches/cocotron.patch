+- (void) _drawTrayIcon {
+    if (_x11TrayWindow == 0) return;
+    X11Display *d = (X11Display *) [NSDisplay currentDisplay];
+    Display *dpy = [d display];
+    if (dpy == NULL) return;
+
+    if (!_x11TrayDocked) {
+        [self _ensureTrayDocked];
+    }
+
+    Window root_ret;
+    int x_ret = 0, y_ret = 0;
+    unsigned int width = 24, height = 24, border_ret = 0, depth_ret = 24;
+    XGetGeometry(dpy, (Window)_x11TrayWindow, &root_ret, &x_ret, &y_ret,
+                 &width, &height, &border_ret, &depth_ret);
+    if (width == 0 || height == 0) {
+        width = 24;
+        height = 24;
+    }
+
+    CGColorSpaceRef colorSpace = CGColorSpaceCreateDeviceRGB();
+    size_t bytesPerRow = width * 4;
+    CGContextRef context = CGBitmapContextCreate(
+            NULL, width, height, 8, bytesPerRow, colorSpace,
+            kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Host);
+    CGColorSpaceRelease(colorSpace);
+    if (context == NULL) return;
+
+    @autoreleasepool {
+        NSGraphicsContext *graphicsContext =
+                [NSGraphicsContext graphicsContextWithGraphicsPort: context
+                                                           flipped: NO];
+
+        [NSGraphicsContext saveGraphicsState];
+        [NSGraphicsContext setCurrentContext: graphicsContext];
+
+        CGContextClearRect(context, CGRectMake(0, 0, width, height));
+
+        NSImage *img = _image ? _image : [_button image];
+        if (img) {
+            NSSize imgSize = [img size];
+            CGFloat drawW = width;
+            CGFloat drawH = height;
+            if (imgSize.width > 0 && imgSize.height > 0) {
+                CGFloat aspect = imgSize.width / imgSize.height;
+                if (aspect >= 1.0) {
+                    drawH = width / aspect;
+                } else {
+                    drawW = height * aspect;
+                }
+            }
+            CGFloat pad = 2.0;
+            if (drawW > width - pad * 2) drawW = width - pad * 2;
+            if (drawH > height - pad * 2) drawH = height - pad * 2;
+            if (drawW < 1.0) drawW = 1.0;
+            if (drawH < 1.0) drawH = 1.0;
+
+            NSRect drawRect = NSMakeRect((width - drawW) / 2.0,
+                                         (height - drawH) / 2.0,
+                                         drawW, drawH);
+            [img drawInRect: drawRect
+                   fromRect: NSZeroRect
+                  operation: NSCompositeSourceOver
+                   fraction: 1.0];
+        }
+
+        [NSGraphicsContext restoreGraphicsState];
+    }
+
+    const uint8_t *rowBytes = CGBitmapContextGetData(context);
+    int screen = DefaultScreen(dpy);
+    Visual *visual = DefaultVisual(dpy, screen);
