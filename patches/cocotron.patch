+/* One -nextEventMatchingMask: pass handles a single run loop source, and Chromium
+ * runs one task per pass: during a drag its drop-target replies fall behind.
+ * Run sources until idle (wait == 0) or until the deadline (wait > 0). */
+static void _NSLocalDragRunPending(NSTimeInterval budget, BOOL wait) {
+    CFAbsoluteTime deadline = CFAbsoluteTimeGetCurrent() + budget;
+    for (;;) {
+        CFTimeInterval left = deadline - CFAbsoluteTimeGetCurrent();
+        if (left <= 0)
+            break;
+        SInt32 result = CFRunLoopRunInMode(kCFRunLoopDefaultMode, wait ? MIN(left, 0.01) : 0, true);
+        if (!wait && result != kCFRunLoopRunHandledSource)
+            break;
+    }
+}
