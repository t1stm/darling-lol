+    XImage *ximage = XCreateImage(dpy, visual, depth_ret, ZPixmap, 0,
+                                  (char *)rowBytes, width, height, 32, bytesPerRow);
+    if (ximage) {
+        GC gc = XCreateGC(dpy, (Window)_x11TrayWindow, 0, NULL);
+        XPutImage(dpy, (Window)_x11TrayWindow, gc, ximage, 0, 0, 0, 0, width, height);
+        XFreeGC(dpy, gc);
+        ximage->data = NULL;
+        XDestroyImage(ximage);
+    }
