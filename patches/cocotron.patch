+static void* getTopLevelWindow(void* dpy, id subwinObj, void* nativeWin) {
+	char enterLog[256];
+	snprintf(enterLog, sizeof(enterLog), "getTopLevelWindow ENTER subWin=%p dpy=%p subwinObj=%p", nativeWin, dpy, (void*)subwinObj);
+	appendDeviceLog(enterLog);
+
+	if (!nativeWin) return nullptr;
+
+	void* topLevelWin = nullptr;
+
+	// 1. Try parentNativeWindow on subwinObj
+	if (subwinObj && [subwinObj respondsToSelector:@selector(parentNativeWindow)]) {
+		void* pw = [subwinObj parentNativeWindow];
+		if (pw != NULL) {
+			topLevelWin = pw;
+			char logBuf[256];
+			snprintf(logBuf, sizeof(logBuf), "getTopLevelWindow: parentNativeWindow resolved topLevelWin=%p", topLevelWin);
+			appendDeviceLog(logBuf);
+		}
+	}
+
+	// 2. Try parentWindow -> windowHandle
+	if (!topLevelWin && subwinObj && [subwinObj respondsToSelector:@selector(parentWindow)]) {
+		id pwObj = [subwinObj performSelector:@selector(parentWindow)];
+		if (pwObj && [pwObj respondsToSelector:@selector(windowHandle)]) {
+			typedef unsigned long (*HandleFn)(id, SEL);
+			HandleFn fn = (HandleFn)[pwObj methodForSelector:@selector(windowHandle)];
+			if (fn) {
+				unsigned long h = fn(pwObj, @selector(windowHandle));
+				if (h != 0) {
+					topLevelWin = (void*)(uintptr_t)h;
+					char logBuf[256];
+					snprintf(logBuf, sizeof(logBuf), "getTopLevelWindow: parentWindow windowHandle resolved topLevelWin=%p", topLevelWin);
+					appendDeviceLog(logBuf);
+				}
+			}
+		}
+	}
+
+	// 3. Try Objective-C reflection on _parent ivar
+	if (!topLevelWin && subwinObj) {
+		@try {
+			Ivar parentIvar = class_getInstanceVariable([subwinObj class], "_parent");
+			if (parentIvar) {
+				id parentObj = object_getIvar(subwinObj, parentIvar);
+				if (parentObj) {
+					if ([parentObj respondsToSelector:@selector(windowHandle)]) {
+						typedef unsigned long (*HandleFn)(id, SEL);
+						HandleFn fn = (HandleFn)[parentObj methodForSelector:@selector(windowHandle)];
+						if (fn) {
+							unsigned long h = fn(parentObj, @selector(windowHandle));
+							if (h != 0) {
+								topLevelWin = (void*)(uintptr_t)h;
+							}
+						}
+					}
+					if (!topLevelWin) {
+						Ivar winIvar = class_getInstanceVariable([parentObj class], "_window");
+						if (winIvar) {
+							ptrdiff_t offset = ivar_getOffset(winIvar);
+							unsigned long w = *(unsigned long*)((char*)(__bridge void*)parentObj + offset);
+							if (w != 0) {
+								topLevelWin = (void*)(uintptr_t)w;
+							}
+						}
+					}
+					if (topLevelWin) {
+						char logBuf[256];
+						snprintf(logBuf, sizeof(logBuf), "getTopLevelWindow: ivar _parent resolved topLevelWin=%p", topLevelWin);
+						appendDeviceLog(logBuf);
+					}
+				}
+			}
+		} @catch (id ex) {}
+	}
+
+	// 4. Query X11 tree hierarchy up to root window (for Xwayland top-level surface)
+	resolveX11Symbols();
+	if (dpy && pfnXQueryTree && pfnXFree) {
+		unsigned long curr = (unsigned long)(uintptr_t)(topLevelWin ? topLevelWin : nativeWin);
+		unsigned long root = 0, parent = 0;
+		unsigned long* children = nullptr;
+		unsigned int nchildren = 0;
+		int depth = 0;
+
+		while (curr != 0 && depth < 20) {
+			int qres = pfnXQueryTree(dpy, curr, &root, &parent, &children, &nchildren);
+			if (children) {
+				pfnXFree(children);
+				children = nullptr;
+			}
+			if (!qres) {
+				char qLog[256];
+				snprintf(qLog, sizeof(qLog), "getTopLevelWindow: XQueryTree failed for win=0x%lx", curr);
+				appendDeviceLog(qLog);
+				break;
+			}
+			char qLog[256];
+			snprintf(qLog, sizeof(qLog), "getTopLevelWindow: XQueryTree curr=0x%lx root=0x%lx parent=0x%lx nchildren=%u", curr, root, parent, nchildren);
+			appendDeviceLog(qLog);
+
+			if (parent == 0 || parent == root) {
+				topLevelWin = (void*)(uintptr_t)curr;
+				break;
+			}
+			topLevelWin = (void*)(uintptr_t)parent;
+			curr = parent;
+			depth++;
+		}
+	}
+
+	if (!topLevelWin) {
+		topLevelWin = nativeWin;
+	}
+
+	char logBuf[256];
+	snprintf(logBuf, sizeof(logBuf), "getTopLevelWindow subWin=%p xqueryTree=%p -> topLevelWin=%p",
+		nativeWin, (void*)pfnXQueryTree, topLevelWin);
+	appendDeviceLog(logBuf);
+
+	return topLevelWin;
+}
+static bool darlingMetalDebug()
+{
+	static const bool enabled = access("/tmp/metal-debug-trace", F_OK) == 0;
+	return enabled;
+}
+
+static void darlingMetalTrace(const char* what, long a, long b)
+{
+	if (!darlingMetalDebug()) {
+		return;
+	}
+	static int count = 0;
+	int n = __sync_add_and_fetch(&count, 1);
+	if (n > 80 && n % 100 != 0) {
+		return;
+	}
+	if (FILE* log = fopen("/tmp/metal-trace.log", "a")) {
+		fprintf(log, "%.3f #%d %s main=%d a=%ld b=%ld\n", CACurrentMediaTime(), n, what, (int) [NSThread isMainThread], a, b);
+		fclose(log);
+	}
+}
+
+static void darlingMetalTiming(const char* what, double seconds)
+{
+	static const bool enabled = access("/tmp/metal-debug-timing", F_OK) == 0;
+	if (!enabled) {
+		return;
+	}
+	struct Stat { double sum = 0, max = 0; unsigned long count = 0; };
+	static std::mutex lock;
+	static std::map<std::string, Stat> stats;
+	static double last = 0;
+	std::lock_guard<std::mutex> guard(lock);
+	Stat& stat = stats[what];
+	stat.sum += seconds;
+	stat.count++;
+	if (seconds > stat.max) stat.max = seconds;
+	double now = CACurrentMediaTime();
+	if (now - last >= 5) {
+		last = now;
+		if (FILE* log = fopen("/tmp/metal-trace.log", "a")) {
+			fprintf(log, "timing@%.0f:", now);
+			for (auto& entry: stats) {
+				fprintf(log, " %s[n=%lu avg=%.0fms max=%.0fms]", entry.first.c_str(), entry.second.count, entry.second.sum / entry.second.count * 1000, entry.second.max * 1000);
+			}
+			fprintf(log, "\n");
+			fclose(log);
+		}
+		stats.clear();
+	}
+}
+
+extern "C" void darlingQCTiming(const char* what, double seconds)
+{
+	darlingMetalTiming(what, seconds);
+}
