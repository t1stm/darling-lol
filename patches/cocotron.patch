+        const uint8_t *rec = bytes + 12 + i * 16;
+        if (rec[0] == 'n' && rec[1] == 'a' && rec[2] == 'm' && rec[3] == 'e') {
+            uint32_t off = sfnt_u32(rec + 8), tlen = sfnt_u32(rec + 12);
