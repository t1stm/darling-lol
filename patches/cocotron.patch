+    }
+    Window win = [window windowHandle];
+    XWindowAttributes attrs;
+    if (!XGetWindowAttributes(_display, win, &attrs)) {
+        if (rclolTraceOn())
+            rclolTraceRated(&rclolConfineChannel, "skip: XGetWindowAttributes failed window=%lu", (unsigned long) win);
+        return;
+    }
